--- /dev/null
+++ b/test/panel-catalogue.test.js
@@ -0,0 +1,82 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+
+import {
+  normalizePubkey, parseReference, readEntry, readListing,
+} from '../src/routes/panel-catalogue.js';
+
+const PUBLISHER = 'a'.repeat(64);
+const OTHER = 'b'.repeat(64);
+
+test('Publisher keys: accept hex and npub, reject everything else', () => {
+  assert.strictEqual(normalizePubkey(PUBLISHER.toUpperCase()), PUBLISHER);
+  assert.strictEqual(
+    normalizePubkey('npub1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq'),
+    null,
+  );
+  assert.strictEqual(normalizePubkey('not-a-key'), null);
+  assert.strictEqual(normalizePubkey(undefined), null);
+});
+
+test('Package reference: split publisher, name and version', () => {
+  assert.deepStrictEqual(parseReference('hello'), { reference: 'hello', version: null });
+  assert.deepStrictEqual(
+    parseReference(`${PUBLISHER}/hello`), { reference: `${PUBLISHER}/hello`, version: null });
+  assert.deepStrictEqual(
+    parseReference(`${PUBLISHER}/hello@1.2.0`),
+    { reference: `${PUBLISHER}/hello`, version: '1.2.0' },
+  );
+  assert.throws(() => parseReference(''), /required/);
+  assert.throws(() => parseReference('../etc'), /must be/);
+  assert.throws(() => parseReference('hello@../1'), /Semantic Version/);
+});
+
+test('Catalogue entry: keep only ncc-service releases with a version', () => {
+  const base = {
+    release_event_id: 'c'.repeat(64),
+    publisher: PUBLISHER,
+    name: 'hello',
+    version: '1.0.0',
+    kind: 'ncc-service',
+    sha256: 'd'.repeat(64),
+    published_at: 1_700_000_000,
+    compatible: true,
+  };
+
+  const entry = readEntry(base, [OTHER]);
+  assert.ok(entry);
+  assert.strictEqual(entry.kind, 'ncc-service');
+  assert.strictEqual(entry.trusted, false);
+  assert.strictEqual(entry.official, false);
+
+  assert.strictEqual(readEntry({ ...base, kind: 'package' }, []).kind, 'package');
+  assert.strictEqual(readEntry({ ...base, name: '' }, []), null);
+  assert.strictEqual(readEntry({ ...base, publisher: 'nope' }, []), null);
+
+  const trusted = readEntry(base, [PUBLISHER]);
+  assert.strictEqual(trusted.trusted, true);
+});
+
+test('Listing: drop unsafe URLs and icons without a signed hash', () => {
+  const listing = readListing({
+    summary: 'A friendly service',
+    homepage: 'javascript:alert(1)',
+    support_url: 'https://example.com/help',
+    screenshots: ['https://example.com/a.png', 'file:///etc/passwd'],
+    icon: { url: 'https://example.com/icon.png', sha256: 'not-a-hash' },
+    categories: ['Social', 'Social', 'Utility'],
+  });
+
+  assert.strictEqual(listing.summary, 'A friendly service');
+  assert.strictEqual(listing.homepage, null);
+  assert.strictEqual(listing.supportUrl, 'https://example.com/help');
+  assert.deepStrictEqual(listing.screenshots, ['https://example.com/a.png']);
+  assert.strictEqual(listing.icon, null);
+  assert.deepStrictEqual(listing.categories, ['Social', 'Social', 'Utility']);
+});
+
+test('Listing: cap long publisher text instead of trusting it', () => {
+  const listing = readListing({ summary: 'x'.repeat(200), description: 'y'.repeat(5000) });
+  assert.strictEqual(listing.summary.length, 140);
+  assert.strictEqual(listing.description.length, 4000);
+});
