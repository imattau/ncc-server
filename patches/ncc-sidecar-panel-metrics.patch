diff --git a/test/panel-metrics.test.js b/test/panel-metrics.test.js
new file mode 100644
index 0000000..f9d83a5
--- /dev/null
+++ b/test/panel-metrics.test.js
@@ -0,0 +1,73 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+
+import { readMetrics } from '../src/routes/panel-services.js';
+
+const sample = {
+  collectedAt: 1_700_000_000,
+  host: {
+    hostname: 'node',
+    kernel: '6.8.0',
+    os: 'Ubuntu 24.04',
+    dockerVersion: '27.3.1',
+    uptimeSeconds: 86_400,
+  },
+  cpu: { cores: 8, load1: 0.4, load5: 0.6, load15: 0.8, usagePercent: 12.5 },
+  memory: {
+    totalBytes: 16_000,
+    availableBytes: 6_000,
+    usedBytes: 10_000,
+    usedPercent: 62.5,
+  },
+  storage: {
+    totalBytes: 100_000,
+    freeBytes: 25_000,
+    usedBytes: 75_000,
+    usedPercent: 75,
+  },
+  docker: {
+    imagesBytes: 1_000,
+    containersBytes: 200,
+    volumesBytes: 300,
+    buildCacheBytes: 400,
+    totalBytes: 1_900,
+    images: 12,
+    containers: 7,
+    volumes: 3,
+  },
+};
+
+test('Metrics: a complete payload is kept as reported', () => {
+  assert.deepStrictEqual(readMetrics(sample), sample);
+});
+
+test('Metrics: missing sections become null instead of zero', () => {
+  const metrics = readMetrics({ collectedAt: 1 });
+  assert.strictEqual(metrics.collectedAt, 1);
+  assert.strictEqual(metrics.host.hostname, null);
+  assert.strictEqual(metrics.cpu, null);
+  assert.strictEqual(metrics.memory, null);
+  assert.strictEqual(metrics.storage, null);
+  assert.strictEqual(metrics.docker, null);
+});
+
+test('Metrics: out-of-range percentages and negative sizes are rejected', () => {
+  const metrics = readMetrics({
+    cpu: { cores: 0, usagePercent: 120 },
+    memory: { totalBytes: -1, usedPercent: -4 },
+    storage: { totalBytes: 10, freeBytes: 4, usedPercent: 150 },
+  });
+  assert.strictEqual(metrics.cpu.cores, null);
+  assert.strictEqual(metrics.cpu.usagePercent, null);
+  assert.strictEqual(metrics.memory.totalBytes, null);
+  assert.strictEqual(metrics.memory.usedPercent, null);
+  assert.strictEqual(metrics.storage.usedPercent, null);
+});
+
+test('Metrics: non-numeric and non-object input is ignored', () => {
+  assert.doesNotThrow(() => readMetrics(null));
+  assert.strictEqual(readMetrics('nope').cpu, null);
+  assert.strictEqual(readMetrics({ cpu: [] }).cpu, null);
+  assert.strictEqual(readMetrics({ host: { hostname: '  ' } }).host.hostname, null);
+  assert.strictEqual(readMetrics({ docker: { images: 0 } }).docker.images, 0);
+});
