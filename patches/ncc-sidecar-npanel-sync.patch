diff --git a/test/panel-npanel-sync.test.js b/test/panel-npanel-sync.test.js
new file mode 100644
index 0000000..db907a0
--- /dev/null
+++ b/test/panel-npanel-sync.test.js
@@ -0,0 +1,261 @@
+/* global Buffer */
+import { test } from 'node:test';
+import assert from 'node:assert';
+import http from 'node:http';
+import { createHash } from 'node:crypto';
+
+import { generateSecretKey, getPublicKey, verifyEvent } from 'nostr-tools/pure';
+
+import {
+  demoteNpanelAdmin, ensureNpanelAdmin, npanelTarget, readNpanelRoles,
+} from '../src/npanel-admins.js';
+
+const DASHBOARD_HOST = '203.0.113.10';
+const secretKey = generateSecretKey();
+const operatorPubkey = getPublicKey(secretKey);
+const targetPubkey = getPublicKey(generateSecretKey());
+const secondPubkey = getPublicKey(generateSecretKey());
+
+function authProblem(request, body) {
+  const header = request.headers.authorization;
+  if (typeof header !== 'string') return 'missing authorization';
+  const match = /^Nostr\s+(\S+)$/i.exec(header);
+  if (!match) return 'malformed authorization';
+
+  let event;
+  try {
+    event = JSON.parse(Buffer.from(match[1], 'base64').toString('utf8'));
+  } catch {
+    return 'unreadable authorization';
+  }
+  if (!verifyEvent(event)) return 'bad signature';
+
+  const tags = new Map(event.tags.map(([name, value]) => [name, value]));
+  const expectedUrl = `http://${DASHBOARD_HOST}${request.url}`;
+  if (tags.get('u') !== expectedUrl) return `u tag ${tags.get('u')} != ${expectedUrl}`;
+  if (tags.get('method') !== request.method) return 'method tag mismatch';
+  if (body && tags.get('payload') !== createHash('sha256').update(body).digest('hex')) {
+    return 'payload tag mismatch';
+  }
+  return null;
+}
+
+/**
+ * A deliberately small stand-in for npanel's dashboard API. It records the
+ * exact requests and enforces the Host/NIP-98 contract the real binary has.
+ */
+async function startNpanel({ users = new Map(), reject = null } = {}) {
+  const calls = [];
+  const server = http.createServer((request, response) => {
+    let body = '';
+    request.on('data', (chunk) => { body += chunk; });
+    request.on('end', () => {
+      const send = (status, payload) => {
+        response.writeHead(status, { 'Content-Type': 'application/json' });
+        response.end(JSON.stringify(payload));
+      };
+      const problem = authProblem(request, body);
+      calls.push({
+        method: request.method,
+        path: request.url,
+        host: request.headers.host,
+        authError: problem,
+        body: body ? JSON.parse(body) : null,
+      });
+
+      if (request.headers.host !== DASHBOARD_HOST) {
+        send(404, { error: 'This domain is not configured.' });
+        return;
+      }
+      if (problem) {
+        send(401, { error: problem });
+        return;
+      }
+      if (reject) {
+        send(reject, { error: reject === 403 ? 'This account has no access to npanel. Ask an admin to add you.' : 'nope' });
+        return;
+      }
+
+      if (request.method === 'GET' && request.url === '/api/users') {
+        send(200, {
+          users: [...users].map(([pubkey, role]) => ({ pubkey, role })),
+        });
+        return;
+      }
+      if (request.method === 'POST' && request.url === '/api/users') {
+        const pubkey = JSON.parse(body).pubkey;
+        if (users.has(pubkey)) {
+          send(409, { error: 'That user already has access.' });
+          return;
+        }
+        users.set(pubkey, 'staff');
+        send(201, { user: { pubkey, role: 'staff' } });
+        return;
+      }
+      const match = /^\/api\/users\/([0-9a-f]{64})$/.exec(request.url);
+      if (request.method === 'PATCH' && match) {
+        const pubkey = match[1];
+        const role = JSON.parse(body).role;
+        if (!users.has(pubkey)) {
+          send(404, { error: 'User not found.' });
+          return;
+        }
+        const admins = [...users.values()].filter((value) => value === 'admin').length;
+        if (role === 'staff' && users.get(pubkey) === 'admin' && admins <= 1) {
+          send(409, { error: "That's the last admin. Promote someone else first." });
+          return;
+        }
+        users.set(pubkey, role);
+        send(200, { user: { pubkey, role } });
+        return;
+      }
+      send(404, { error: 'User not found.' });
+    });
+  });
+
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  const env = {
+    NCC_NPANEL_URL: `http://127.0.0.1:${server.address().port}`,
+    NCC_NPANEL_HOST: DASHBOARD_HOST,
+  };
+  return { server, calls, users, env, close: () => new Promise((resolve) => server.close(resolve)) };
+}
+
+test('npanel target needs a dashboard host and a loopback http URL', () => {
+  assert.deepStrictEqual(
+    npanelTarget({ NCC_NPANEL_HOST: '203.0.113.10' }),
+    { host: '203.0.113.10', hostname: '127.0.0.1', port: 3200 },
+  );
+  assert.strictEqual(npanelTarget({}), null);
+  assert.strictEqual(npanelTarget({ NCC_NPANEL_HOST: 'host/path' }), null);
+  assert.strictEqual(npanelTarget({ NCC_NPANEL_HOST: 'host', NCC_NPANEL_URL: 'https://127.0.0.1:3200' }), null);
+  assert.strictEqual(npanelTarget({ NCC_NPANEL_HOST: 'host', NCC_NPANEL_URL: 'nonsense' }), null);
+});
+
+test('A new npanel user is created and promoted to admin', async () => {
+  const npanel = await startNpanel();
+  try {
+    const result = await ensureNpanelAdmin(targetPubkey, { secretKey, env: npanel.env });
+    assert.deepStrictEqual(result, { configured: true, synced: true, role: 'admin', error: null });
+    assert.strictEqual(npanel.users.get(targetPubkey), 'admin');
+
+    const [created, promoted] = npanel.calls;
+    assert.strictEqual(created.method, 'POST');
+    assert.deepStrictEqual(created.body, { pubkey: targetPubkey });
+    assert.strictEqual(created.host, DASHBOARD_HOST);
+    assert.strictEqual(created.authError, null);
+    assert.strictEqual(promoted.method, 'PATCH');
+    assert.deepStrictEqual(promoted.body, { role: 'admin' });
+    assert.strictEqual(promoted.authError, null);
+  } finally {
+    await npanel.close();
+  }
+});
+
+test('An existing npanel staff user is promoted instead of duplicated', async () => {
+  const npanel = await startNpanel({ users: new Map([[targetPubkey, 'staff']]) });
+  try {
+    const result = await ensureNpanelAdmin(targetPubkey, { secretKey, env: npanel.env });
+    assert.strictEqual(result.synced, true);
+    assert.strictEqual(npanel.users.get(targetPubkey), 'admin');
+    assert.deepStrictEqual(npanel.calls.map((call) => call.method), ['POST', 'PATCH']);
+  } finally {
+    await npanel.close();
+  }
+});
+
+test('A npanel rejection is reported without throwing', async () => {
+  const npanel = await startNpanel({ reject: 403 });
+  try {
+    const result = await ensureNpanelAdmin(targetPubkey, { secretKey, env: npanel.env });
+    assert.strictEqual(result.synced, false);
+    assert.match(result.error, /not an npanel admin/);
+  } finally {
+    await npanel.close();
+  }
+});
+
+test('An unreachable npanel is reported without throwing', async () => {
+  const npanel = await startNpanel();
+  const env = npanel.env;
+  await npanel.close();
+  const result = await ensureNpanelAdmin(targetPubkey, { secretKey, env });
+  assert.strictEqual(result.synced, false);
+  assert.match(result.error, /not reachable/);
+});
+
+test('Removing a node admin demotes the npanel user to staff', async () => {
+  const npanel = await startNpanel({
+    users: new Map([[operatorPubkey, 'admin'], [targetPubkey, 'admin']]),
+  });
+  try {
+    const result = await demoteNpanelAdmin(targetPubkey, { secretKey, env: npanel.env });
+    assert.deepStrictEqual(result, { configured: true, synced: true, role: 'staff', error: null });
+    assert.strictEqual(npanel.users.get(targetPubkey), 'staff');
+  } finally {
+    await npanel.close();
+  }
+});
+
+test('Demoting a key with no npanel user succeeds', async () => {
+  const npanel = await startNpanel({ users: new Map([[operatorPubkey, 'admin']]) });
+  try {
+    const result = await demoteNpanelAdmin(targetPubkey, { secretKey, env: npanel.env });
+    assert.deepStrictEqual(result, { configured: true, synced: true, role: null, error: null });
+  } finally {
+    await npanel.close();
+  }
+});
+
+test('The last npanel admin cannot be demoted, and that is reported', async () => {
+  const npanel = await startNpanel({ users: new Map([[targetPubkey, 'admin']]) });
+  try {
+    const result = await demoteNpanelAdmin(targetPubkey, { secretKey, env: npanel.env });
+    assert.strictEqual(result.synced, false);
+    assert.match(result.error, /last admin/);
+  } finally {
+    await npanel.close();
+  }
+});
+
+test('The npanel role map is read for the admin list', async () => {
+  const npanel = await startNpanel({
+    users: new Map([[operatorPubkey, 'admin'], [secondPubkey, 'staff']]),
+  });
+  try {
+    const result = await readNpanelRoles({ secretKey, env: npanel.env });
+    assert.strictEqual(result.available, true);
+    assert.deepStrictEqual(result.roles, {
+      [operatorPubkey]: 'admin',
+      [secondPubkey]: 'staff',
+    });
+    assert.strictEqual(npanel.calls[0].method, 'GET');
+    assert.strictEqual(npanel.calls[0].authError, null);
+  } finally {
+    await npanel.close();
+  }
+});
+
+test('An unconfigured node reports npanel as absent rather than failing', async () => {
+  const result = await readNpanelRoles({ secretKey, env: {} });
+  assert.deepStrictEqual(result, {
+    configured: false,
+    available: false,
+    roles: {},
+    error: 'npanel admin sync is not configured',
+  });
+  const sync = await ensureNpanelAdmin(targetPubkey, { secretKey, env: {} });
+  assert.strictEqual(sync.configured, false);
+  assert.strictEqual(sync.synced, false);
+});
+
+test('A missing signing key is reported, not thrown', async () => {
+  const npanel = await startNpanel();
+  try {
+    const result = await ensureNpanelAdmin(targetPubkey, { secretKey: null, env: npanel.env });
+    assert.strictEqual(result.synced, false);
+    assert.match(result.error, /no signing key/);
+  } finally {
+    await npanel.close();
+  }
+});
