diff --git a/src/npanel-admins.js b/src/npanel-admins.js
new file mode 100644
index 0000000..bb9aef1
--- /dev/null
+++ b/src/npanel-admins.js
@@ -0,0 +1,238 @@
+/* global Buffer */
+/**
+ * Keep npanel's administrator list in step with the NCC node admin list.
+ *
+ * The panel's admin list lives in the sidecar database; npanel keeps its own
+ * `users` table and cannot read the sidecar's. The panel used to update only
+ * the sidecar, so a key added from the GUI could open the NCC panel but not
+ * npanel. This module bridges the two with npanel's own dashboard API.
+ *
+ * Calls go to npanel's loopback HTTP listener with the operator key's NIP-98
+ * signature. npanel routes the dashboard by Host header, so the request must
+ * carry npanel's configured `dashboard_host` (the bundle sets it to
+ * PUBLIC_IPV4) rather than the loopback address. Node's `fetch` overrides a
+ * custom Host header, which is why this uses `node:http` directly.
+ *
+ * Nothing here throws: a failed sync returns a structured result so a npanel
+ * outage cannot undo or block a change to the node's admin list.
+ */
+
+import http from 'node:http';
+import { createHash } from 'node:crypto';
+
+import { finalizeEvent } from 'nostr-tools/pure';
+
+const DEFAULT_URL = 'http://127.0.0.1:3200';
+const REQUEST_TIMEOUT_MS = 4000;
+const HOST_PATTERN = /^[A-Za-z0-9.[\]:-]+$/;
+const NIP98_KIND = 27235;
+
+/**
+ * Resolve the npanel endpoint from the environment.
+ *
+ * `NCC_NPANEL_URL` is the loopback listener (the sidecar uses host
+ * networking). `NCC_NPANEL_HOST` is what npanel believes its dashboard host
+ * is; it becomes the Host header and the NIP-98 `u` origin.
+ */
+export function npanelTarget(env = process.env) {
+  const host = String(env.NCC_NPANEL_HOST || '').trim();
+  if (!host || !HOST_PATTERN.test(host)) return null;
+
+  let url;
+  try {
+    url = new URL(String(env.NCC_NPANEL_URL || DEFAULT_URL));
+  } catch {
+    return null;
+  }
+  // The listener is a plain-HTTP loopback port. Supporting TLS here would
+  // mean validating npanel's own certificate for no benefit.
+  if (url.protocol !== 'http:') return null;
+
+  return {
+    host,
+    hostname: url.hostname,
+    port: Number(url.port || 80),
+  };
+}
+
+function nip98Header(secretKey, url, method, payload) {
+  const tags = [['u', url], ['method', method]];
+  if (payload !== null) {
+    tags.push(['payload', createHash('sha256').update(payload).digest('hex')]);
+  }
+  const event = finalizeEvent({
+    kind: NIP98_KIND,
+    created_at: Math.floor(Date.now() / 1000),
+    tags,
+    content: '',
+  }, secretKey);
+  return `Nostr ${Buffer.from(JSON.stringify(event)).toString('base64')}`;
+}
+
+function request(target, secretKey, path, { method = 'GET', body = null } = {}) {
+  const payload = body === null ? null : JSON.stringify(body);
+  const url = `http://${target.host}${path}`;
+  const authorization = nip98Header(secretKey, url, method, payload);
+
+  return new Promise((resolve, reject) => {
+    const request = http.request({
+      hostname: target.hostname,
+      port: target.port,
+      path,
+      method,
+      headers: {
+        Host: target.host,
+        Authorization: authorization,
+        Accept: 'application/json',
+        ...(payload === null ? {} : {
+          'Content-Type': 'application/json',
+          'Content-Length': Buffer.byteLength(payload),
+        }),
+      },
+    }, (response) => {
+      const chunks = [];
+      response.on('data', (chunk) => chunks.push(chunk));
+      response.on('error', reject);
+      response.on('end', () => {
+        const text = Buffer.concat(chunks).toString('utf8');
+        let parsed = null;
+        try {
+          parsed = text ? JSON.parse(text) : null;
+        } catch {
+          // A proxy or an older npanel may answer with HTML; the status is
+          // still useful, so keep the body as text.
+        }
+        resolve({ status: response.statusCode || 0, body: parsed, text });
+      });
+    });
+
+    request.setTimeout(REQUEST_TIMEOUT_MS, () => {
+      request.destroy(new Error('npanel request timed out'));
+    });
+    request.on('error', reject);
+    if (payload !== null) request.write(payload);
+    request.end();
+  });
+}
+
+function detail(response) {
+  const message = response.body && typeof response.body.error === 'string'
+    ? response.body.error
+    : '';
+  return message || `npanel returned HTTP ${response.status}`;
+}
+
+function describeResponse(response) {
+  if (response.status === 401) {
+    return `npanel rejected the operator key's signature (${detail(response)})`;
+  }
+  if (response.status === 403) {
+    return 'the node operator key is not an npanel admin';
+  }
+  if (response.status === 404) {
+    return `npanel did not serve its users API (${detail(response)})`;
+  }
+  return detail(response);
+}
+
+function describeError(error) {
+  if (error && error.code === 'ECONNREFUSED') {
+    return 'npanel is not reachable on its loopback port';
+  }
+  if (error && /timed out/i.test(String(error.message))) {
+    return 'npanel did not answer in time';
+  }
+  return `npanel request failed: ${error instanceof Error ? error.message : String(error)}`;
+}
+
+function failed(error, configured = true) {
+  return { configured, synced: false, role: null, error };
+}
+
+function unavailable(error, configured = true) {
+  return { configured, available: false, roles: {}, error };
+}
+
+/**
+ * Make a pubkey an npanel administrator. Idempotent: npanel answers 409 when
+ * the user already exists, and the role update then promotes them.
+ */
+export async function ensureNpanelAdmin(pubkey, { secretKey, env = process.env } = {}) {
+  const target = npanelTarget(env);
+  if (!target) return failed('npanel admin sync is not configured', false);
+  if (!secretKey) return failed('the node has no signing key for npanel');
+
+  try {
+    const created = await request(target, secretKey, '/api/users', {
+      method: 'POST',
+      body: { pubkey },
+    });
+    if (created.status !== 200 && created.status !== 201 && created.status !== 409) {
+      return failed(describeResponse(created));
+    }
+
+    const updated = await request(target, secretKey, `/api/users/${pubkey}`, {
+      method: 'PATCH',
+      body: { role: 'admin' },
+    });
+    if (updated.status === 200 && updated.body?.user?.role === 'admin') {
+      return { configured: true, synced: true, role: 'admin', error: null };
+    }
+    return failed(describeResponse(updated));
+  } catch (error) {
+    return failed(describeError(error));
+  }
+}
+
+/**
+ * Drop npanel administrator rights when a key leaves the node admin list.
+ * The user is kept as `staff` rather than deleted so any sites granted to
+ * them keep working; an unknown user is already effectively removed.
+ */
+export async function demoteNpanelAdmin(pubkey, { secretKey, env = process.env } = {}) {
+  const target = npanelTarget(env);
+  if (!target) return failed('npanel admin sync is not configured', false);
+  if (!secretKey) return failed('the node has no signing key for npanel');
+
+  try {
+    const updated = await request(target, secretKey, `/api/users/${pubkey}`, {
+      method: 'PATCH',
+      body: { role: 'staff' },
+    });
+    if (updated.status === 200 && updated.body?.user?.role === 'staff') {
+      return { configured: true, synced: true, role: 'staff', error: null };
+    }
+    if (updated.status === 404 && /user not found/i.test(detail(updated))) {
+      // No npanel user to demote, which is the desired end state. A 404 for
+      // any other reason means the request never reached the dashboard.
+      return { configured: true, synced: true, role: null, error: null };
+    }
+    return failed(describeResponse(updated));
+  } catch (error) {
+    return failed(describeError(error));
+  }
+}
+
+/** Current npanel roles keyed by hex pubkey, for the panel's admin list. */
+export async function readNpanelRoles({ secretKey, env = process.env } = {}) {
+  const target = npanelTarget(env);
+  if (!target) return unavailable('npanel admin sync is not configured', false);
+  if (!secretKey) return unavailable('the node has no signing key for npanel');
+
+  try {
+    const response = await request(target, secretKey, '/api/users');
+    if (response.status !== 200 || !Array.isArray(response.body?.users)) {
+      return unavailable(describeResponse(response));
+    }
+    const roles = {};
+    for (const user of response.body.users) {
+      if (!user || typeof user.pubkey !== 'string') continue;
+      if (user.role === 'admin' || user.role === 'staff') {
+        roles[user.pubkey.toLowerCase()] = user.role;
+      }
+    }
+    return { configured: true, available: true, roles, error: null };
+  } catch (error) {
+    return unavailable(describeError(error));
+  }
+}
