diff --git a/test/panel-settings.test.js b/test/panel-settings.test.js
new file mode 100644
index 0000000..c124cba
--- /dev/null
+++ b/test/panel-settings.test.js
@@ -0,0 +1,75 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+
+import {
+  normalizeCadence, normalizeIdentity, normalizeRelayUrl,
+} from '../src/routes/panel-settings.js';
+
+test('Publication relays: normalise host, http(s) and ws(s) forms', () => {
+  assert.strictEqual(normalizeRelayUrl('relay.example'), 'wss://relay.example/');
+  assert.strictEqual(normalizeRelayUrl('https://relay.example'), 'wss://relay.example/');
+  assert.strictEqual(normalizeRelayUrl('http://127.0.0.1:7777'), 'ws://127.0.0.1:7777/');
+  assert.strictEqual(normalizeRelayUrl('wss://relay.example/path/'), 'wss://relay.example/path/');
+});
+
+test('Publication relays: reject values that are not relays', () => {
+  assert.strictEqual(normalizeRelayUrl(''), null);
+  assert.strictEqual(normalizeRelayUrl('ftp://relay.example'), null);
+  assert.strictEqual(normalizeRelayUrl('https://user:pass@relay.example'), null);
+  assert.strictEqual(normalizeRelayUrl('wss://relay.example/?query=1'), null);
+  assert.strictEqual(normalizeRelayUrl('not a url'), null);
+});
+
+test('Public identity: require a display name and derive the short name', () => {
+  const result = normalizeIdentity({
+    displayName: 'Harbour Node',
+    about: 'A community node.',
+    picture: 'https://example.com/avatar.png',
+    nip05: 'harbour@example.com',
+  });
+
+  assert.strictEqual(result.error, undefined);
+  assert.strictEqual(result.identity.name, 'harbour_node');
+  assert.strictEqual(result.identity.displayName, 'Harbour Node');
+  assert.strictEqual(result.profile.display_name, 'Harbour Node');
+  assert.strictEqual(result.profile.nip05, 'harbour@example.com');
+});
+
+test('Public identity: reject missing or unsafe fields', () => {
+  assert.match(normalizeIdentity({ displayName: '' }).error, /display name is required/i);
+  assert.match(normalizeIdentity({ displayName: 'X', picture: 'http://example.com/a.png' }).error, /https/);
+  assert.match(normalizeIdentity({ displayName: 'X', nip05: 'not-an-address' }).error, /NIP-05/);
+});
+
+test('Publication cadence: accept values that outlive the publish interval', () => {
+  const result = normalizeCadence({
+    refreshIntervalMinutes: '60',
+    ncc02ExpiryDays: '7',
+    ncc05TtlHours: '3',
+  });
+
+  assert.deepStrictEqual(result.cadence, {
+    refreshIntervalMinutes: 60,
+    ncc02ExpiryDays: 7,
+    ncc05TtlHours: 3,
+  });
+});
+
+test('Publication cadence: reject gaps and out-of-range values', () => {
+  assert.match(
+    normalizeCadence({ refreshIntervalMinutes: 720, ncc02ExpiryDays: 14, ncc05TtlHours: 12 }).error,
+    /Locator TTL/,
+  );
+  assert.match(
+    normalizeCadence({ refreshIntervalMinutes: 2880, ncc02ExpiryDays: 2, ncc05TtlHours: 60 }).error,
+    /Service record expiry/,
+  );
+  assert.match(
+    normalizeCadence({ refreshIntervalMinutes: 0, ncc02ExpiryDays: 14, ncc05TtlHours: 12 }).error,
+    /refreshIntervalMinutes/,
+  );
+  assert.match(
+    normalizeCadence({ refreshIntervalMinutes: 60, ncc02ExpiryDays: 14, ncc05TtlHours: 1.5 }).error,
+    /ncc05TtlHours/,
+  );
+});
