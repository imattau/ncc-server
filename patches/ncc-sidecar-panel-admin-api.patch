diff --git a/src/nip98.js b/src/nip98.js
new file mode 100644
index 0000000..a55e12d
--- /dev/null
+++ b/src/nip98.js
@@ -0,0 +1,120 @@
+/**
+ * NIP-98 HTTP authentication for the NCC panel admin API.
+ *
+ * The admin panel runs in a browser and cannot reach the sidecar's loopback
+ * listener, so Caddy proxies `/ncc-api/*` here. That makes the NIP-98
+ * signature the authorization boundary: every request must carry a kind 27235
+ * event signed by an active admin key, bound to this exact URL and method.
+ *
+ * Kept independent of the database and Fastify so it can be unit tested on
+ * its own. Import it only from server code.
+ */
+
+import { verifyEvent } from 'nostr-tools/pure';
+
+export const NIP98_KIND = 27235;
+
+/**
+ * A short window limits replay, but remote signers (NIP-46) keep the
+ * template's created_at while the user approves on another device. Five
+ * minutes covers that handoff without accepting old captures indefinitely.
+ */
+export const NIP98_MAX_AGE_SECONDS = 300;
+
+const REPLAY_TTL_MS = 10 * 60 * 1000;
+const PUBKEY_PATTERN = /^[0-9a-f]{64}$/i;
+
+/** Event ids accepted recently, so a captured header cannot be replayed. */
+const accepted = new Map();
+
+function pruneAccepted(nowMs) {
+  for (const [id, expiresAt] of accepted) {
+    if (expiresAt <= nowMs) accepted.delete(id);
+  }
+}
+
+function tagValue(event, name) {
+  if (!Array.isArray(event.tags)) return null;
+  const tag = event.tags.find((entry) => Array.isArray(entry) && entry[0] === name);
+  return typeof tag?.[1] === 'string' ? tag[1] : null;
+}
+
+function readAuthEvent(request) {
+  const header = request.headers?.authorization;
+  if (typeof header !== 'string') return null;
+
+  const match = /^Nostr\s+(\S+)\s*$/i.exec(header.trim());
+  if (!match) return null;
+
+  let event;
+  try {
+    event = JSON.parse(Buffer.from(match[1], 'base64').toString('utf8'));
+  } catch {
+    return null;
+  }
+
+  if (!event || typeof event !== 'object' || Array.isArray(event)) return null;
+  if (event.kind !== NIP98_KIND) return null;
+  if (typeof event.content !== 'string') return null;
+  if (typeof event.created_at !== 'number') return null;
+  if (typeof event.pubkey !== 'string' || !PUBKEY_PATTERN.test(event.pubkey)) return null;
+  if (!Array.isArray(event.tags)) return null;
+  if (typeof event.id !== 'string' || typeof event.sig !== 'string') return null;
+
+  return event;
+}
+
+/**
+ * The public URL of the request as the client signed it.
+ *
+ * Caddy forwards the original Host header (with the port) and sets
+ * X-Forwarded-Proto explicitly. X-Forwarded-Host is not used: Caddy's proxy
+ * rewrites it to the bare hostname, which drops the port the client signed.
+ */
+export function requestUrl(request) {
+  const forwardedProto = request.headers?.['x-forwarded-proto'];
+  const proto = (typeof forwardedProto === 'string' && forwardedProto.split(',')[0].trim())
+    || request.protocol
+    || 'http';
+  const host = request.headers?.host || '';
+  const path = request.raw?.url || request.url || '/';
+  return `${proto}://${host}${path}`;
+}
+
+/**
+ * Verify a NIP-98 Authorization header against the request.
+ *
+ * @returns {{ ok: true, pubkey: string } | { ok: false, status: number, error: string }}
+ */
+export function verifyNip98(request, { now = Math.floor(Date.now() / 1000), nowMs = Date.now() } = {}) {
+  const event = readAuthEvent(request);
+  if (!event) {
+    return { ok: false, status: 401, error: 'Missing or malformed NIP-98 authorization' };
+  }
+
+  if (!verifyEvent(event)) {
+    return { ok: false, status: 401, error: 'NIP-98 event signature is invalid' };
+  }
+
+  if (Math.abs(now - event.created_at) > NIP98_MAX_AGE_SECONDS) {
+    return { ok: false, status: 401, error: 'NIP-98 event is outside the accepted time window' };
+  }
+
+  const method = tagValue(event, 'method');
+  if (!method || method !== request.method) {
+    return { ok: false, status: 401, error: 'NIP-98 method tag does not match this request' };
+  }
+
+  const url = tagValue(event, 'u');
+  if (!url || url !== requestUrl(request)) {
+    return { ok: false, status: 401, error: 'NIP-98 url tag does not match this request' };
+  }
+
+  pruneAccepted(nowMs);
+  if (accepted.has(event.id)) {
+    return { ok: false, status: 401, error: 'NIP-98 event was already used' };
+  }
+  accepted.set(event.id, nowMs + REPLAY_TTL_MS);
+
+  return { ok: true, pubkey: event.pubkey.toLowerCase() };
+}
diff --git a/src/panel-auth.js b/src/panel-auth.js
new file mode 100644
index 0000000..70c386e
--- /dev/null
+++ b/src/panel-auth.js
@@ -0,0 +1,34 @@
+/**
+ * Authorization for the NCC admin panel API.
+ *
+ * Caddy proxies `/ncc-api/*` from the public listener to this loopback
+ * process, so the binding cannot be the access boundary. Every request
+ * carries a NIP-98 event signed by the connected key (../nip98.js), and the
+ * signer must be on this node's admin list. Routes call this once per
+ * request and return its result.
+ */
+
+import { verifyNip98 } from './nip98.js';
+import { getAdmins } from './db.js';
+
+/**
+ * Resolve the calling key and require it to be an active admin.
+ *
+ * Sends the error response itself and returns null when the request is not
+ * authorized, so a route only has to check for a falsy return value.
+ */
+export function authorizePanelRequest(request, reply) {
+  const result = verifyNip98(request);
+  if (!result.ok) {
+    reply.code(result.status).send({ error: result.error });
+    return null;
+  }
+
+  const admin = getAdmins().find((entry) => entry.pubkey === result.pubkey);
+  if (!admin) {
+    reply.code(403).send({ error: 'This key is not an admin for this node' });
+    return null;
+  }
+
+  return admin;
+}
diff --git a/src/routes/panel-admin.js b/src/routes/panel-admin.js
new file mode 100644
index 0000000..3245251
--- /dev/null
+++ b/src/routes/panel-admin.js
@@ -0,0 +1,145 @@
+/**
+ * Admin panel API.
+ *
+ * The panel is a static page, so it cannot call the loopback management API
+ * directly. Caddy publishes these routes at `/ncc-api/*` on the admin
+ * listener and proxies them here. Unlike `/api/*`, which trusts the loopback
+ * binding, every request here is authorized per call by NIP-98
+ * (see ../nip98.js): the signer must be an active admin for this node.
+ *
+ * Only the panel uses these routes. The sidecar's own UI keeps using /api/*.
+ */
+
+import { nip19 } from 'nostr-tools';
+import { authorizePanelRequest } from '../panel-auth.js';
+import {
+  addAdmin, addLog, getAdmins, getConfig, getServices, removeAdmin,
+} from '../db.js';
+import { sendInviteDM } from '../dm.js';
+import { fromNsec, getPublicKey, toNpub } from 'ncc-06-js';
+
+const PUBKEY_PATTERN = /^[0-9a-f]{64}$/i;
+
+/** Accept a bech32 npub or a hex pubkey; return lowercase hex or null. */
+function parsePubkey(value) {
+  if (typeof value !== 'string') return null;
+  const trimmed = value.trim();
+
+  if (PUBKEY_PATTERN.test(trimmed)) return trimmed.toLowerCase();
+  if (!trimmed.toLowerCase().startsWith('npub1')) return null;
+
+  try {
+    const decoded = nip19.decode(trimmed.toLowerCase());
+    return decoded.type === 'npub' ? decoded.data.toLowerCase() : null;
+  } catch {
+    return null;
+  }
+}
+
+// The sidecar's `status` column is informational (nothing ever promotes a
+// pending invite), so the list itself is the authorization boundary.
+function admins() {
+  return getAdmins();
+}
+
+function adminList() {
+  return getAdmins().map((admin) => ({
+    pubkey: admin.pubkey,
+    npub: nip19.npubEncode(admin.pubkey),
+    status: admin.status || 'active',
+    createdAt: admin.created_at || null,
+  }));
+}
+
+/**
+ * Tell the new admin they were added. Best effort: the key is already
+ * usable, and the publish cycle sends the recovery payload separately.
+ */
+async function notifyNewAdmin(pubkey) {
+  try {
+    const services = getServices();
+    const sidecar = services.find((service) => service.type === 'sidecar') || services[0];
+    if (!sidecar?.service_nsec) return false;
+
+    const appConfig = getConfig('app_config') || {};
+    const relays = Array.isArray(appConfig.publication_relays) ? appConfig.publication_relays : [];
+    if (!relays.length) return false;
+
+    const secretKey = fromNsec(sidecar.service_nsec);
+    const identity = toNpub(getPublicKey(secretKey));
+
+    return await sendInviteDM({
+      secretKey,
+      recipientPubkey: pubkey,
+      message: `You were added as an admin for the NCC node ${identity}. `
+        + 'Open the node admin panel with your Nostr key to manage it.',
+      relays,
+    });
+  } catch (err) {
+    console.warn('[Panel] Could not notify the new admin:', err.message);
+    return false;
+  }
+}
+
+export default async function panelAdminRoutes(server) {
+  server.get('/ncc-api/admins', async (request, reply) => {
+    if (!authorizePanelRequest(request, reply)) return;
+    return { admins: adminList() };
+  });
+
+  server.post('/ncc-api/admins', async (request, reply) => {
+    const caller = authorizePanelRequest(request, reply);
+    if (!caller) return;
+
+    const body = request.body && typeof request.body === 'object' ? request.body : {};
+    const pubkey = parsePubkey(body.npub ?? body.pubkey);
+    if (!pubkey) {
+      return reply.code(400).send({ error: 'Provide a valid npub or 64-character hex public key' });
+    }
+
+    const existing = getAdmins().find((admin) => admin.pubkey === pubkey);
+    if (existing && existing.status !== 'pending') {
+      return { added: false, inviteSent: false, admins: adminList() };
+    }
+
+    addAdmin(pubkey, 'active');
+    addLog('info', 'Admin key added from the NCC admin panel', {
+      pubkey,
+      addedBy: caller.pubkey,
+    });
+
+    const inviteSent = await notifyNewAdmin(pubkey);
+    return { added: true, inviteSent, admins: adminList() };
+  });
+
+  server.delete('/ncc-api/admins/:pubkey', async (request, reply) => {
+    const caller = authorizePanelRequest(request, reply);
+    if (!caller) return;
+
+    const pubkey = parsePubkey(request.params.pubkey);
+    if (!pubkey) {
+      return reply.code(400).send({ error: 'Provide a valid npub or 64-character hex public key' });
+    }
+
+    const operatorPubkey = String(process.env.NCC_OPERATOR_PUBKEY || '').toLowerCase();
+    if (operatorPubkey && pubkey === operatorPubkey) {
+      return reply.code(409).send({ error: 'The node operator key cannot be removed' });
+    }
+
+    const list = admins();
+    if (!list.some((admin) => admin.pubkey === pubkey)) {
+      return reply.code(404).send({ error: 'That key is not an admin for this node' });
+    }
+    if (list.length <= 1) {
+      return reply.code(409).send({ error: 'The last admin key cannot be removed' });
+    }
+
+    removeAdmin(pubkey);
+    addLog('info', 'Admin key removed from the NCC admin panel', {
+      pubkey,
+      removedBy: caller.pubkey,
+    });
+
+    return { removed: true, admins: adminList() };
+  });
+}
diff --git a/src/routes/panel-settings.js b/src/routes/panel-settings.js
new file mode 100644
index 0000000..b7f6586
--- /dev/null
+++ b/src/routes/panel-settings.js
@@ -0,0 +1,493 @@
+/**
+ * Node settings for the NCC admin panel.
+ *
+ * The panel edits the values the sidecar publishes: where records go
+ * (publication relays), the kind 0 identity clients see, and how often
+ * records are refreshed. Like the admin routes, every request is authorized
+ * per call by NIP-98 (see ../panel-auth.js).
+ *
+ * Writes are applied to `app_config` and to every service that publishes for
+ * this node, because they all share one operator identity. The next publish
+ * cycle (within a minute) republishes the affected records; the routes mark
+ * services for an immediate cycle instead of running one inline, so a save
+ * does not block on Tor or endpoint probes.
+ */
+
+import { SimplePool } from 'nostr-tools';
+import WebSocket from 'ws';
+import { authorizePanelRequest } from '../panel-auth.js';
+import {
+  addLog, getConfig, getServices, setConfig, updateService,
+} from '../db.js';
+import { fromNsec, getPublicKey, toNpub } from 'ncc-06-js';
+
+const PUBKEY_PATTERN = /^[0-9a-f]{64}$/i;
+const DEFAULT_CADENCE = {
+  refreshIntervalMinutes: 360,
+  ncc02ExpiryDays: 14,
+  ncc05TtlHours: 12,
+};
+const CADENCE_LIMITS = {
+  refreshIntervalMinutes: { min: 5, max: 10080 },
+  ncc02ExpiryDays: { min: 1, max: 365 },
+  ncc05TtlHours: { min: 1, max: 720 },
+};
+const MAX_RELAYS = 20;
+const MAX_IDENTITY = {
+  displayName: 64,
+  name: 32,
+  about: 500,
+  picture: 400,
+  nip05: 128,
+};
+
+/** Services that publish NCC records under the shared operator identity. */
+function publishingServices() {
+  return getServices().filter((service) => service.status === 'active' && service.type !== 'sidecar');
+}
+
+function operatorPubkey() {
+  const configured = String(process.env.NCC_OPERATOR_PUBKEY || '').toLowerCase();
+  if (PUBKEY_PATTERN.test(configured)) return configured;
+
+  const services = getServices();
+  const sidecar = services.find((service) => service.type === 'sidecar') || services[0];
+  if (!sidecar?.service_nsec) return null;
+
+  try {
+    return getPublicKey(fromNsec(sidecar.service_nsec));
+  } catch {
+    return null;
+  }
+}
+
+/** Normalise one relay URL, accepting host, http(s) and ws(s) forms. */
+export function normalizeRelayUrl(value) {
+  if (typeof value !== 'string') return null;
+
+  let candidate = value.trim();
+  if (!candidate) return null;
+
+  if (/^https?:\/\//i.test(candidate)) {
+    candidate = candidate.replace(/^https?:\/\//i, (match) => (match.toLowerCase() === 'https://' ? 'wss://' : 'ws://'));
+  } else if (/^[a-z][a-z0-9+.-]*:\/\//i.test(candidate)) {
+    if (!/^wss?:\/\//i.test(candidate)) return null;
+  } else {
+    candidate = `wss://${candidate}`;
+  }
+
+  try {
+    const url = new URL(candidate);
+    if (url.protocol !== 'wss:' && url.protocol !== 'ws:') return null;
+    if (!url.hostname || url.username || url.password) return null;
+    if (url.search || url.hash) return null;
+    const path = url.pathname === '/' ? '/' : `${url.pathname.replace(/\/+$/, '')}/`;
+    return `${url.protocol}//${url.host}${path}`;
+  } catch {
+    return null;
+  }
+}
+
+function readRelays() {
+  const appConfig = getConfig('app_config') || {};
+  const configured = Array.isArray(appConfig.publication_relays) ? appConfig.publication_relays : [];
+  if (configured.length) return configured.filter(Boolean);
+
+  const services = getServices();
+  const sidecar = services.find((service) => service.type === 'sidecar');
+  const fallback = Array.isArray(sidecar?.config?.publication_relays)
+    ? sidecar.config.publication_relays
+    : [];
+
+  return fallback.filter(Boolean);
+}
+
+const RECORD_CONNECT_TIMEOUT_MS = 5000;
+const RECORD_QUERY_TIMEOUT_MS = 7000;
+const RECORD_RELAY_LIMIT = 20;
+
+/**
+ * Query the node's own NCC records from its publication relays.
+ *
+ * The panel cannot do this itself: NCC Browser pages are not allowed to open
+ * WebSockets to public relays, so every relay would appear unreachable and
+ * the overview would be empty. The sidecar has normal network access and
+ * already knows which relays the node publishes to.
+ */
+async function queryPublishedRecords() {
+  const pubkey = operatorPubkey();
+  const relays = readRelays().slice(0, RECORD_RELAY_LIMIT);
+  if (!pubkey || relays.length === 0) return { relays: [], events: [] };
+
+  const pool = new SimplePool({ websocketImplementation: WebSocket });
+  const reports = [];
+  const events = [];
+
+  try {
+    await Promise.all(relays.map(async (url) => {
+      const report = { url, connected: false, anchorCount: 0, locatorCount: 0 };
+
+      try {
+        const relay = await pool.ensureRelay(url, { connectionTimeout: RECORD_CONNECT_TIMEOUT_MS });
+        report.connected = relay.connected;
+
+        const found = await pool.querySync([url], {
+          kinds: [30059, 30058],
+          authors: [pubkey],
+          limit: 200,
+        }, { maxWait: RECORD_QUERY_TIMEOUT_MS });
+
+        for (const event of found) {
+          if (event.pubkey !== pubkey) continue;
+          if (event.kind === 30059) report.anchorCount += 1;
+          else if (event.kind === 30058) report.locatorCount += 1;
+          events.push(event);
+        }
+      } catch (error) {
+        report.error = error instanceof Error ? error.message : 'connection failed';
+      }
+
+      reports.push(report);
+    }));
+  } finally {
+    pool.close(relays);
+  }
+
+  const unique = [...new Map(events.map((event) => [event.id, event])).values()];
+  reports.sort((a, b) => a.url.localeCompare(b.url));
+  return { relays: reports, events: unique };
+}
+
+function normalizeRelays(value) {
+  if (!Array.isArray(value)) {
+    return { error: 'relays must be an array of relay URLs' };
+  }
+
+  const relays = [];
+  for (const entry of value) {
+    const relay = normalizeRelayUrl(entry);
+    if (!relay) {
+      return { error: `"${String(entry)}" is not a valid relay URL (use wss://relay.example/)` };
+    }
+    if (!relays.includes(relay)) relays.push(relay);
+  }
+
+  if (relays.length === 0) {
+    return { error: 'Keep at least one publication relay, or the node cannot publish records' };
+  }
+  if (relays.length > MAX_RELAYS) {
+    return { error: `Use at most ${MAX_RELAYS} publication relays` };
+  }
+
+  return { relays };
+}
+
+function profileFromService(service) {
+  const profile = service?.config?.profile;
+  if (!profile || typeof profile !== 'object') return null;
+
+  return {
+    name: typeof profile.name === 'string' ? profile.name : '',
+    displayName: typeof profile.display_name === 'string' ? profile.display_name : '',
+    about: typeof profile.about === 'string' ? profile.about : '',
+    picture: typeof profile.picture === 'string' ? profile.picture : '',
+    nip05: typeof profile.nip05 === 'string' ? profile.nip05 : '',
+  };
+}
+
+function readIdentity() {
+  const appConfig = getConfig('app_config') || {};
+  const stored = appConfig.public_identity;
+  if (stored && typeof stored === 'object' && !Array.isArray(stored)) {
+    return {
+      name: typeof stored.name === 'string' ? stored.name : '',
+      displayName: typeof stored.displayName === 'string' ? stored.displayName : '',
+      about: typeof stored.about === 'string' ? stored.about : '',
+      picture: typeof stored.picture === 'string' ? stored.picture : '',
+      nip05: typeof stored.nip05 === 'string' ? stored.nip05 : '',
+    };
+  }
+
+  for (const service of getServices()) {
+    const profile = profileFromService(service);
+    if (profile && (profile.name || profile.displayName)) return profile;
+  }
+
+  return { name: '', displayName: '', about: '', picture: '', nip05: '' };
+}
+
+function slugName(displayName) {
+  return displayName
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '_')
+    .replace(/^_+|_+$/g, '')
+    .slice(0, MAX_IDENTITY.name);
+}
+
+/** Validate identity fields from the panel and build the kind 0 profile. */
+export function normalizeIdentity(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return { error: 'identity must be an object' };
+  }
+
+  const field = (name) => (typeof value[name] === 'string' ? value[name].trim() : '');
+
+  const displayName = field('displayName') || field('display_name');
+  const about = field('about');
+  const picture = field('picture');
+  const nip05 = field('nip05');
+  const name = field('name') || slugName(displayName);
+
+  if (!displayName) return { error: 'A display name is required' };
+  if (displayName.length > MAX_IDENTITY.displayName) {
+    return { error: `Display name must be at most ${MAX_IDENTITY.displayName} characters` };
+  }
+  if (name.length > MAX_IDENTITY.name) {
+    return { error: `Name must be at most ${MAX_IDENTITY.name} characters` };
+  }
+  if (about.length > MAX_IDENTITY.about) {
+    return { error: `About must be at most ${MAX_IDENTITY.about} characters` };
+  }
+  if (nip05.length > MAX_IDENTITY.nip05) {
+    return { error: `NIP-05 address must be at most ${MAX_IDENTITY.nip05} characters` };
+  }
+  if (nip05 && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(nip05)) {
+    return { error: 'NIP-05 must look like name@example.com' };
+  }
+  if (picture) {
+    if (picture.length > MAX_IDENTITY.picture) {
+      return { error: `Picture URL must be at most ${MAX_IDENTITY.picture} characters` };
+    }
+    try {
+      if (new URL(picture).protocol !== 'https:') {
+        return { error: 'Picture URL must use https://' };
+      }
+    } catch {
+      return { error: 'Picture URL is not a valid https URL' };
+    }
+  }
+
+  const identity = { name, displayName, about, picture, nip05 };
+  const profile = { name };
+  if (displayName) profile.display_name = displayName;
+  if (about) profile.about = about;
+  if (picture) profile.picture = picture;
+  if (nip05) profile.nip05 = nip05;
+
+  return { identity, profile };
+}
+
+function readCadence() {
+  const appConfig = getConfig('app_config') || {};
+  const stored = appConfig.publication_cadence;
+  if (stored && typeof stored === 'object' && !Array.isArray(stored)) {
+    return {
+      refreshIntervalMinutes: Number(stored.refreshIntervalMinutes) || DEFAULT_CADENCE.refreshIntervalMinutes,
+      ncc02ExpiryDays: Number(stored.ncc02ExpiryDays) || DEFAULT_CADENCE.ncc02ExpiryDays,
+      ncc05TtlHours: Number(stored.ncc05TtlHours) || DEFAULT_CADENCE.ncc05TtlHours,
+    };
+  }
+
+  const services = getServices();
+  const representative = services.find((service) => service.service_id === 'web')
+    || publishingServices()[0]
+    || services[0];
+
+  if (!representative?.config) return { ...DEFAULT_CADENCE };
+
+  return {
+    refreshIntervalMinutes: Number(representative.config.refresh_interval_minutes)
+      || DEFAULT_CADENCE.refreshIntervalMinutes,
+    ncc02ExpiryDays: Number(representative.config.ncc02_expiry_days)
+      || DEFAULT_CADENCE.ncc02ExpiryDays,
+    ncc05TtlHours: Number(representative.config.ncc05_ttl_hours)
+      || DEFAULT_CADENCE.ncc05TtlHours,
+  };
+}
+
+export function normalizeCadence(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return { error: 'cadence must be an object' };
+  }
+
+  const cadence = {};
+  for (const [key, limits] of Object.entries(CADENCE_LIMITS)) {
+    const raw = typeof value[key] === 'string' ? value[key].trim() : value[key];
+    const number = Number(raw);
+    if (!Number.isInteger(number) || number < limits.min || number > limits.max) {
+      return { error: `${key} must be a whole number between ${limits.min} and ${limits.max}` };
+    }
+    cadence[key] = number;
+  }
+
+  if (cadence.ncc05TtlHours * 60 <= cadence.refreshIntervalMinutes) {
+    return { error: 'Locator TTL must be longer than the publish interval, or records expire before they are refreshed' };
+  }
+  if (cadence.ncc02ExpiryDays * 1440 <= cadence.refreshIntervalMinutes) {
+    return { error: 'Service record expiry must be longer than the publish interval, or records expire before they are refreshed' };
+  }
+
+  return { cadence };
+}
+
+function lastPublishedAt() {
+  const timestamps = getServices()
+    .map((service) => Number(service.state?.last_full_publish_timestamp) || 0)
+    .filter((value) => value > 0);
+
+  return timestamps.length ? Math.max(...timestamps) : null;
+}
+
+function settingsPayload() {
+  const pubkey = operatorPubkey();
+  const identity = readIdentity();
+  const services = publishingServices();
+
+  return {
+    operator: {
+      pubkey,
+      npub: pubkey ? toNpub(pubkey) : null,
+    },
+    relays: readRelays(),
+    identity: {
+      ...identity,
+      published: getServices().some((service) => Boolean(service.state?.last_published_kind0_id)),
+    },
+    cadence: readCadence(),
+    publication: {
+      services: services.length,
+      lastPublishedAt: lastPublishedAt(),
+    },
+  };
+}
+
+function markForRepublish(services, { anchors = false, locators = false } = {}) {
+  for (const service of services) {
+    const state = { last_full_publish_timestamp: 0 };
+    if (anchors) state.last_primary_endpoint_hash = null;
+    if (locators) state.last_endpoints_hash = null;
+    updateService(service.id, { state });
+  }
+}
+
+export default async function panelSettingsRoutes(server) {
+  server.get('/ncc-api/settings', async (request, reply) => {
+    if (!authorizePanelRequest(request, reply)) return;
+    return settingsPayload();
+  });
+
+  server.get('/ncc-api/records', async (request, reply) => {
+    if (!authorizePanelRequest(request, reply)) return;
+    return queryPublishedRecords();
+  });
+
+  server.put('/ncc-api/settings/relays', async (request, reply) => {
+    const caller = authorizePanelRequest(request, reply);
+    if (!caller) return;
+
+    const body = request.body && typeof request.body === 'object' ? request.body : {};
+    const result = normalizeRelays(body.relays);
+    if (result.error) return reply.code(400).send({ error: result.error });
+
+    const appConfig = getConfig('app_config') || {};
+    appConfig.publication_relays = result.relays;
+    setConfig('app_config', appConfig);
+
+    // The sidecar reads the per-service list first, so keep both in sync.
+    // Invalidating the endpoint hashes makes the next cycle publish anchors
+    // and locators to the new relay set instead of waiting for an interval.
+    const services = getServices();
+    for (const service of services) {
+      updateService(service.id, {
+        config: { publication_relays: result.relays },
+        state: {
+          last_primary_endpoint_hash: null,
+          last_endpoints_hash: null,
+          last_full_publish_timestamp: 0,
+        },
+      });
+    }
+
+    addLog('info', 'Publication relays changed from the NCC admin panel', {
+      relays: result.relays,
+      changedBy: caller.pubkey,
+    });
+
+    return settingsPayload();
+  });
+
+  server.put('/ncc-api/settings/identity', async (request, reply) => {
+    const caller = authorizePanelRequest(request, reply);
+    if (!caller) return;
+
+    const body = request.body && typeof request.body === 'object' ? request.body : {};
+    const result = normalizeIdentity(body);
+    if (result.error) return reply.code(400).send({ error: result.error });
+
+    const appConfig = getConfig('app_config') || {};
+    appConfig.public_identity = result.identity;
+    setConfig('app_config', appConfig);
+
+    // Every standard service shares the operator key, so they must publish
+    // the same kind 0. Fields the panel does not edit (banner, website, …)
+    // are preserved. The sidecar service is left alone: its job is the node's
+    // local management API, not a public profile.
+    for (const service of publishingServices()) {
+      const current = service.config?.profile && typeof service.config.profile === 'object'
+        ? { ...service.config.profile }
+        : {};
+      for (const key of ['name', 'display_name', 'about', 'picture', 'nip05']) delete current[key];
+
+      updateService(service.id, {
+        config: { profile: { ...current, ...result.profile } },
+        state: { last_profile_hash: null },
+      });
+    }
+
+    addLog('info', 'Public identity changed from the NCC admin panel', {
+      displayName: result.identity.displayName,
+      nip05: result.identity.nip05 || null,
+      changedBy: caller.pubkey,
+    });
+
+    return settingsPayload();
+  });
+
+  server.put('/ncc-api/settings/cadence', async (request, reply) => {
+    const caller = authorizePanelRequest(request, reply);
+    if (!caller) return;
+
+    const body = request.body && typeof request.body === 'object' ? request.body : {};
+    const result = normalizeCadence(body);
+    if (result.error) return reply.code(400).send({ error: result.error });
+
+    const appConfig = getConfig('app_config') || {};
+    appConfig.publication_cadence = result.cadence;
+    setConfig('app_config', appConfig);
+
+    const services = publishingServices();
+    for (const service of services) {
+      updateService(service.id, {
+        config: {
+          refresh_interval_minutes: result.cadence.refreshIntervalMinutes,
+          ncc02_expiry_days: result.cadence.ncc02ExpiryDays,
+          ncc05_ttl_hours: result.cadence.ncc05TtlHours,
+        },
+        // Expiry values are baked into the published events, so the anchors
+        // have to be rewritten for the new cadence to take effect; otherwise
+        // they would keep their old expiration until the endpoint changes.
+        state: {
+          last_primary_endpoint_hash: null,
+          last_full_publish_timestamp: 0,
+        },
+      });
+    }
+
+    addLog('info', 'Publication cadence changed from the NCC admin panel', {
+      ...result.cadence,
+      changedBy: caller.pubkey,
+    });
+
+    return settingsPayload();
+  });
+}
