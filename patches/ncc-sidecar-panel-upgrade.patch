diff --git a/test/panel-upgrade.test.js b/test/panel-upgrade.test.js
new file mode 100644
index 0000000..d52f562
--- /dev/null
+++ b/test/panel-upgrade.test.js
@@ -0,0 +1,54 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  compareVersions,
+  currentTag,
+  normalizeTarget,
+  parseOrigin,
+  versionFromTag,
+} from '../src/routes/panel-upgrade.js';
+
+test('Upgrade: parses GitHub remotes and ignores other forges', () => {
+  assert.deepEqual(
+    parseOrigin('https://github.com/imattau/ncc-server.git'),
+    { owner: 'imattau', repo: 'ncc-server' },
+  );
+  assert.deepEqual(
+    parseOrigin('git@github.com:imattau/ncc-server.git'),
+    { owner: 'imattau', repo: 'ncc-server' },
+  );
+  assert.deepEqual(
+    parseOrigin('ssh://git@github.com/imattau/ncc-server'),
+    { owner: 'imattau', repo: 'ncc-server' },
+  );
+  assert.equal(parseOrigin('https://gitlab.com/imattau/ncc-server'), null);
+  assert.equal(parseOrigin(null), null);
+});
+
+test('Upgrade: normalises release targets', () => {
+  assert.equal(normalizeTarget('0.2.13'), 'v0.2.13');
+  assert.equal(normalizeTarget('v0.2.13'), 'v0.2.13');
+  assert.equal(normalizeTarget('main'), null);
+  assert.equal(normalizeTarget('v0.2'), null);
+  assert.equal(normalizeTarget('v0.2.13; rm -rf /'), null);
+});
+
+test('Upgrade: compares release versions', () => {
+  assert.equal(compareVersions('v0.2.12', 'v0.2.13'), -1);
+  assert.equal(compareVersions('0.2.13', 'v0.2.12'), 1);
+  assert.equal(compareVersions('v0.2.13', '0.2.13'), 0);
+  assert.equal(compareVersions('v0.10.0', 'v0.9.9'), 1);
+  assert.equal(compareVersions('latest', 'v0.2.13'), null);
+  assert.equal(versionFromTag('v0.2.13'), '0.2.13');
+  assert.equal(versionFromTag('main'), null);
+});
+
+test('Upgrade: prefers the host release file and falls back to the image tag', () => {
+  assert.equal(currentTag({ tag: 'v0.2.12' }, { tag: '0.2.11' }), 'v0.2.12');
+  assert.equal(currentTag({ version: '0.2.12' }, null), 'v0.2.12');
+  assert.equal(currentTag(null, { tag: '0.2.12' }), 'v0.2.12');
+  assert.equal(currentTag(null, { tag: 'latest' }), null);
+  assert.equal(currentTag(null, { tag: 'sidecar-2026-11-16' }), null);
+  assert.equal(currentTag(null, null), null);
+});
