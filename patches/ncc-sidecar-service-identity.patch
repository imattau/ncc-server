--- a/src/service-identity.js	1970-01-01 10:00:00.000000000 +1000
+++ b/src/service-identity.js	2026-11-23 14:31:34.211956001 +1100
@@ -0,0 +1,139 @@
+/** Per-service key rotation and retirement of the old address. */
+
+import { fromNsec, generateKeypair, getPublicKey, toNpub } from 'ncc-06-js';
+import { addLog, getConfig, getServices, updateService } from './db.js';
+import { publishToRelays } from './publisher.js';
+
+function publicationRelays(service) {
+  const configured = Array.isArray(service?.config?.publication_relays)
+    ? service.config.publication_relays.filter(Boolean)
+    : [];
+  if (configured.length) return configured;
+
+  const appConfig = getConfig('app_config') || {};
+  const fromApp = Array.isArray(appConfig.publication_relays)
+    ? appConfig.publication_relays.filter(Boolean)
+    : [];
+  if (fromApp.length) return fromApp;
+
+  const sidecar = getServices().find((candidate) => candidate.type === 'sidecar');
+  return Array.isArray(sidecar?.config?.publication_relays)
+    ? sidecar.config.publication_relays.filter(Boolean)
+    : [];
+}
+
+export function serviceNpub(service) {
+  if (!service?.service_nsec) return null;
+  try {
+    return toNpub(getPublicKey(fromNsec(service.service_nsec)));
+  } catch {
+    return null;
+  }
+}
+
+export function resetPublishState(state) {
+  return {
+    ...(state && typeof state === 'object' ? state : {}),
+    is_probing: false,
+    last_published_ncc02_id: null,
+    last_published_ncc05_id: null,
+    last_published_kind0_id: null,
+    last_primary_endpoint_hash: null,
+    last_endpoints_hash: null,
+    last_profile_hash: null,
+    last_full_publish_timestamp: 0,
+    last_success_per_relay: {},
+  };
+}
+
+/**
+ * Replace the old author's records before the old key is discarded.
+ *
+ * A relocation to a new npub would otherwise leave the previous public locator
+ * (and its fallback `u` anchor) resolvable until its normal expiry. The
+ * locator is expired and the anchor is republished without an endpoint, with
+ * `private=true` so ncc-search drops any row it still has for the old address.
+ */
+export async function retireServiceIdentity(service) {
+  const state = service?.state || {};
+  const hadRecords = Boolean(state.last_published_ncc02_id || state.last_published_ncc05_id);
+  if (!hadRecords) return { retired: true, skipped: true, relays: [] };
+
+  const relays = publicationRelays(service);
+  if (!relays.length) throw new Error('No publication relays are configured, so the old records cannot be retired');
+
+  const secretKey = fromNsec(service.service_nsec);
+  const serviceId = service.service_id;
+  const locatorId = service.config?.locator_id || `${serviceId}-locator`;
+  const now = Math.floor(Date.now() / 1000);
+  const locator = {
+    kind: 30058,
+    created_at: now,
+    tags: [
+      ['d', locatorId],
+      ['expiration', String(now - 1)],
+      ['private', 'true'],
+    ],
+    content: JSON.stringify({ v: 1, ttl: 1, updated_at: now - 2, endpoints: [] }),
+  };
+  const anchor = {
+    kind: 30059,
+    created_at: now,
+    tags: [
+      ['d', serviceId],
+      ['exp', String(now + 86_400)],
+      ['private', 'true'],
+    ],
+    content: `NCC-02 Service Record for ${serviceId}`,
+  };
+
+  const results = await publishToRelays(relays, [locator, anchor], secretKey);
+  const relaysOk = Object.entries(results)
+    .filter(([, result]) => result?.success)
+    .map(([relay]) => relay);
+  const failures = Object.entries(results)
+    .filter(([, result]) => !result?.success)
+    .map(([relay, result]) => `${relay}: ${result?.error || 'publish failed'}`);
+  if (relaysOk.length === 0) {
+    throw new Error(`The old address could not be retired: ${failures.join('; ')}`);
+  }
+  return { retired: true, skipped: false, relays: relaysOk, failures };
+}
+
+/**
+ * Generate a new npub for one service. `config` lets the visibility dialog
+ * change privacy and identity in one publish cycle instead of publishing the
+ * service publicly under its new key first.
+ */
+export async function rotateServiceIdentity(service, { config, retireOld = true } = {}) {
+  if (!service?.service_nsec) throw new Error('That service has no signing key');
+  const previousNpub = serviceNpub(service);
+  let retirement = { retired: false, skipped: true, relays: [] };
+  if (retireOld) retirement = await retireServiceIdentity(service);
+
+  const keys = generateKeypair();
+  const nextConfig = {
+    ...(service.config && typeof service.config === 'object' ? service.config : {}),
+    ...(config && typeof config === 'object' ? config : {}),
+    service_identity: 'dedicated',
+  };
+  updateService(service.id, {
+    service_nsec: keys.nsec,
+    config: nextConfig,
+    state: resetPublishState(service.state),
+  });
+  addLog('info', `Generated a dedicated npub for ${service.name}`, {
+    serviceId: service.id,
+    previousNpub,
+    npub: keys.npub,
+    retiredOldRecords: retirement.retired && !retirement.skipped,
+  });
+
+  return {
+    service: getServices().find((candidate) => String(candidate.id) === String(service.id)) || service,
+    previousNpub,
+    npub: keys.npub,
+    nsec: keys.nsec,
+    retirement,
+  };
+}
