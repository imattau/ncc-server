+function parsePubkey(value) {
+  if (typeof value !== 'string') return null;
+  const trimmed = value.trim();
+  if (HEX_PUBKEY.test(trimmed)) return trimmed.toLowerCase();
+  if (!trimmed.toLowerCase().startsWith('npub1')) return null;
+  try {
+    const decoded = nip19.decode(trimmed.toLowerCase());
+    return decoded.type === 'npub' ? decoded.data.toLowerCase() : null;
+  } catch {
+    return null;
+  }
+}
+
+function recipientNpub(value) {
+  if (typeof value !== 'string' || !HEX_PUBKEY.test(value)) return null;
+  try {
+    return nip19.npubEncode(value.toLowerCase());
+  } catch {
+    return null;
+  }
+}
+
+function serviceVisibility(service) {
+  const config = service.config && typeof service.config === 'object' ? service.config : {};
+  const mode = config.service_mode === 'private' ? 'private' : 'public';
+  const recipients = Array.isArray(config.ncc05_recipients)
+    ? config.ncc05_recipients
+      .map(parsePubkey)
+      .filter((value) => value !== null)
+    : [];
+  return {
+    mode,
+    recipients: [...new Set(recipients)],
+    npubs: [...new Set(recipients)].map(recipientNpub).filter(Boolean),
+  };
+}
+
+function defaultRecipients(explicit, includeAdmins) {
+  const adminKeys = getAdmins()
+    .map((admin) => parsePubkey(admin.pubkey))
+    .filter((value) => value !== null);
+  const recipients = includeAdmins
+    ? [...explicit]
+    : explicit.filter((value) => !adminKeys.includes(value));
+  const operator = parsePubkey(process.env.NCC_OPERATOR_PUBKEY || '');
+  if (operator) recipients.push(operator);
+  if (includeAdmins) recipients.push(...adminKeys);
+  return [...new Set(recipients)];
+}
