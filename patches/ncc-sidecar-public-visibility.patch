+  // Recipients, health, npub and every other panel field stay behind
+  // authorizePanelRequest above.
+  server.get('/ncc-api/public/visibility', async () => {
+    const services = getServices().filter((service) => service.type !== 'sidecar' && service.status !== 'disabled');
+    const payload = services
+      .map((service) => ({ serviceId: service.service_id, visibility: serviceVisibility(service).mode }))
+      .sort((left, right) => left.serviceId.localeCompare(right.serviceId));
+    return { services: payload };
+  });
