+
+/** The tracked services for a live token, or null when it is unknown/expired. */
+function progressTokenServices(token) {
+  if (typeof token !== 'string' || !token) return null;
+  const entry = progressTokens.get(token);
+  if (!entry) return null;
+  if (entry.expiresAt <= Date.now()) {
+    progressTokens.delete(token);
+    return null;
+  }
+  // Sliding expiry: a long update keeps being readable while it is polled.
+  entry.expiresAt = Date.now() + PROGRESS_TOKEN_TTL_MS;
+  return entry.services;
+}
