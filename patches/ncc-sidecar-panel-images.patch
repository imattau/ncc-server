+function issueProgressToken(services) {
+  const now = Date.now();
+  for (const [token, entry] of progressTokens) {
+    if (entry.expiresAt <= now) progressTokens.delete(token);
+  }
+  const token = randomBytes(24).toString('base64url');
+  progressTokens.set(token, {
+    services: [...services],
+    expiresAt: now + PROGRESS_TOKEN_TTL_MS,
+  });
