@@ -0,0 +1,190 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+
+import { imageTag, progressSnapshot, readNodeImages } from '../src/routes/panel-services.js';
+
+test('Images: tag parsing keeps registry ports out of the tag', () => {
+  assert.strictEqual(imageTag('ghcr.io/imattau/ncc-server-relay:latest'), 'latest');
+  assert.strictEqual(imageTag('ghcr.io/imattau/ncc-server-relay:0.2.8'), '0.2.8');
+  assert.strictEqual(imageTag('registry.example:5000/team/app'), 'latest');
+  assert.strictEqual(imageTag('registry.example:5000/team/app:1.2.3'), '1.2.3');
+  assert.strictEqual(imageTag('ghcr.io/imattau/ncc-server-relay@sha256:abc'), null);
+  assert.strictEqual(imageTag(null), null);
+});
+
+test('Images: only bundle services with a container are listed', () => {
+  const images = readNodeImages([
+    {
+      service: 'relay',
+      image: 'ghcr.io/imattau/ncc-server-relay:latest',
+      imageId: 'sha256:relay',
+      imageCreatedAt: '2026-01-01T00:00:00Z',
+      state: 'running',
+      health: null,
+      name: 'ncc-bundle-relay-1',
+    },
+    {
+      service: 'hello',
+      image: 'ghcr.io/acme/hello:1.0.0',
+      imageId: 'sha256:hello',
+      state: 'running',
+    },
+  ]);
+
+  assert.deepStrictEqual(images.map((image) => image.service), ['relay']);
+  assert.strictEqual(images[0].label, 'Nostr relay');
+  assert.strictEqual(images[0].tag, 'latest');
+  assert.strictEqual(images[0].imageId, 'sha256:relay');
+  assert.strictEqual(images[0].imageCreatedAt, '2026-01-01T00:00:00Z');
+  assert.strictEqual(images[0].updatable, true);
+  assert.deepStrictEqual(images[0].containers, [
+    { name: 'ncc-bundle-relay-1', state: 'running', health: null },
+  ]);
+});
+
+test('Images: order follows the bundle, not the agent response', () => {
+  const images = readNodeImages([
+    { service: 'tor', state: 'running' },
+    { service: 'sidecar', state: 'running' },
+    { service: 'relay', state: 'running' },
+  ]);
+  assert.deepStrictEqual(
+    images.map((image) => image.service),
+    ['sidecar', 'relay', 'tor'],
+  );
+});
+
+test('Images: a digest-pinned image is shown but not updateable', () => {
+  const [image] = readNodeImages([{
+    service: 'npanel',
+    image: 'ghcr.io/imattau/ncc-server-npanel@sha256:abcdef',
+    imageId: 'sha256:npanel',
+    state: 'running',
+  }]);
+
+  assert.strictEqual(image.tag, null);
+  assert.strictEqual(image.updatable, false);
+});
+
+test('Images: update status is merged and unknown states stay unknown', () => {
+  const [image] = readNodeImages(
+    [{ service: 'superseded', state: 'running' }],
+    { services: [] },
+  );
+  assert.strictEqual(image, undefined, 'unknown service names are ignored');
+
+  const [relay] = readNodeImages(
+    [
+      { service: 'relay', image: 'ghcr.io/imattau/ncc-server-relay:latest', state: 'running' },
+      { service: 'sidecar', image: 'ghcr.io/imattau/ncc-server-sidecar:latest', state: 'running' },
+    ],
+    {
+      inProgress: true,
+      services: [{ service: 'relay', state: 'mystery', changed: true, error: 'nope' }],
+    },
+  ).filter((image) => image.service === 'relay');
+  assert.deepStrictEqual(relay.update, {
+    state: 'unknown', changed: true, imageId: null, error: 'nope',
+  });
+});
+
+test('Images: a stopped or unhealthy container is reported as such', () => {
+  const [search] = readNodeImages([
+    { service: 'search', image: 'x:1', state: 'running', health: 'healthy', name: 'a' },
+    { service: 'search', image: 'x:1', state: 'exited', health: null, name: 'b' },
+  ]);
+
+  assert.strictEqual(search.state, 'exited');
+  assert.deepStrictEqual(search.containers.map((entry) => entry.name), ['a', 'b']);
+
+  const [searchUi] = readNodeImages([
+    { service: 'search-ui', image: 'x:1', state: 'running', health: 'unhealthy', name: 'c' },
+  ]);
+  assert.strictEqual(searchUi.health, 'unhealthy');
+});
+
+test('Images: an empty or malformed payload yields an empty list', () => {
+  assert.deepStrictEqual(readNodeImages(undefined, null), []);
+  assert.deepStrictEqual(readNodeImages([null, 3], { services: 'nope' }), []);
+});
+
+test('Images: registry checks mark a newer digest as updateable', () => {
+  const [relay] = readNodeImages(
+    [{ service: 'relay', image: 'ghcr.io/imattau/ncc-server-relay:latest', imageId: 'sha256:relay', state: 'running' }],
+    null,
+    [{
+      service: 'relay',
+      remoteDigest: 'sha256:new',
+      localDigests: ['sha256:old'],
+      updateAvailable: true,
+      checkError: null,
+      checkedAt: '2026-11-20T10:00:00.000Z',
+    }],
+  );
+
+  assert.strictEqual(relay.updateAvailable, true);
+  assert.strictEqual(relay.remoteDigest, 'sha256:new');
+  assert.strictEqual(relay.checkError, null);
+  assert.strictEqual(relay.checkedAt, '2026-11-20T10:00:00.000Z');
+});
+
+test('Images: an equal digest is up to date and an unknown check stays null', () => {
+  const base = { service: 'relay', image: 'ghcr.io/imattau/ncc-server-relay:latest', state: 'running' };
+  const [current] = readNodeImages([base], null, [{
+    service: 'relay', remoteDigest: 'sha256:same', localDigests: ['sha256:same'],
+    updateAvailable: false, checkError: null, checkedAt: '2026-11-20T10:00:00.000Z',
+  }]);
+  assert.strictEqual(current.updateAvailable, false);
+
+  const [unknown] = readNodeImages([base], null, [{
+    service: 'relay', remoteDigest: null, localDigests: [],
+    updateAvailable: null, checkError: 'Registry unreachable', checkedAt: null,
+  }]);
+  assert.strictEqual(unknown.updateAvailable, null);
+  assert.strictEqual(unknown.checkError, 'Registry unreachable');
+
+  const [missing] = readNodeImages([base], null, null);
+  assert.strictEqual(missing.updateAvailable, null);
+  assert.strictEqual(missing.checkError, null);
+});
+
+
+test('Images: progress counts only tracked services and finishes on terminal states', () => {
+  const progress = progressSnapshot({
+    inProgress: true,
+    startedAt: 10,
+    finishedAt: null,
+    error: null,
+    services: [
+      { service: 'relay', state: 'recreated', changed: true, imageId: 'sha256:new', error: null },
+      { service: 'npanel', state: 'pulling', changed: null, error: null },
+      { service: 'search', state: 'failed', changed: null, error: 'registry refused' },
+      { service: 'caddy', state: 'recreated', changed: true, error: null },
+    ],
+  }, ['relay', 'npanel', 'search']);
+
+  assert.strictEqual(progress.total, 3);
+  assert.strictEqual(progress.done, 2);
+  assert.strictEqual(progress.percent, 67);
+  assert.strictEqual(progress.inProgress, true);
+  assert.deepStrictEqual(progress.services.map((entry) => entry.state), ['recreated', 'pulling', 'failed']);
+  assert.strictEqual(progress.services[0].imageId, 'sha256:new');
+  assert.strictEqual(progress.services[1].imageId, null);
+  assert.strictEqual(progress.services[2].error, 'registry refused');
+});
+
+test('Images: progress reports unknown states without inventing completion', () => {
+  const progress = progressSnapshot(null, ['relay', 'npanel']);
+  assert.strictEqual(progress.inProgress, false);
+  assert.strictEqual(progress.total, 2);
+  assert.strictEqual(progress.done, 0);
+  assert.strictEqual(progress.percent, 0);
+  assert.deepStrictEqual(progress.services.map((entry) => entry.state), ['unknown', 'unknown']);
+});
+
+test('Images: progress handles an empty tracked list', () => {
+  const progress = progressSnapshot({ inProgress: false, services: [] }, []);
