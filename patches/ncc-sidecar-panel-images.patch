+      state: UPDATE_STATES.has(entry?.state) ? entry.state : 'unknown',
+      changed: entry?.changed === true,
+      imageId: typeof entry?.imageId === 'string' ? entry.imageId : null,
+      error: typeof entry?.error === 'string' && entry.error ? entry.error : null,
+    };
+  });
+  const done = services.filter((entry) => PROGRESS_DONE.has(entry.state)).length;
+
+  return {
+    inProgress: status?.inProgress === true,
+    startedAt: Number.isFinite(status?.startedAt) ? status.startedAt : null,
+    finishedAt: Number.isFinite(status?.finishedAt) ? status.finishedAt : null,
+    error: typeof status?.error === 'string' && status.error ? status.error : null,
+    total: services.length,
+    done,
+    percent: services.length ? Math.round((done / services.length) * 100) : 0,
+    services,
+  };
+}
