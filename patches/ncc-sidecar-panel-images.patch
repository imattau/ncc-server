+        method: 'POST',
+        body: { services },
+        timeoutMs: 20_000,
+      });
+      const progressToken = issueProgressToken(services);
+
+      addLog('info', `Image update started for ${services.join(', ')} from the NCC admin panel`, {
+        containers: services,
+        changedBy: caller.pubkey,
+      });
+
+      return {
+        success: true,
+        services,
+        accepted: payload?.accepted === true,
+        status: payload?.status ?? null,
