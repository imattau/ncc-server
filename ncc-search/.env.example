# Relays to crawl for NCC-02 (30059/30060/30061) and NCC-05 (30058) records.
NCC_SEARCH_RELAYS=wss://relay.primal.net,wss://relay.damus.io

NCC_SEARCH_DB_PATH=/var/lib/ncc-search/ncc-search.db
NCC_SEARCH_HTTP_HOST=127.0.0.1
NCC_SEARCH_HTTP_PORT=7780

# The backend runs as two processes sharing that SQLite file: the API
# (src/api.js, ports above) and the crawler (src/index.js). The crawler's
# listener below is private -- loopback here, the crawler's service name in
# compose.yaml -- and carries crawl health plus the NIP-50 ingest forwarding.
NCC_SEARCH_INTERNAL_HOST=127.0.0.1
NCC_SEARCH_INTERNAL_PORT=7781
# Only the API process reads this; leave unset when both run on this host.
NCC_SEARCH_CRAWLER_URL=

# Disk-space ceiling for the index, in bytes (e.g. 500000000 for ~500MB).
# Empty/0 (the default) leaves growth unbounded. When set, the
# least-recently-resolved rows are evicted (LRU on last_resolved_at) on the
# same tick interval as everything else (NCC_SEARCH_TICK_MS below) to stay
# under the limit -- see store.js's pruneToFit().
NCC_SEARCH_DB_MAX_BYTES=

# Reuses this host's existing Tor SOCKS listener (see docs/schema-verification.md);
# no separate Tor instance is started by this process.
NCC_SEARCH_TOR_SOCKS=socks5h://127.0.0.1:9050

# Comma-separated hex pubkeys of certifiers this indexer trusts for NCC-02
# Kind 30060 attestations. Empty = attestations are recorded but never
# counted toward trust level in search ranking.
NCC_SEARCH_TRUSTED_CA_PUBKEYS=

# How often the crawl queue is drained, in milliseconds.
NCC_SEARCH_TICK_MS=15000

# Per-fetch timeout and response size cap when crawling a resolved endpoint
# or a Blossom blob.
NCC_SEARCH_FETCH_TIMEOUT_MS=10000
NCC_SEARCH_FETCH_MAX_BYTES=1000000

# Also discover and index nsites (NIP-5A, kind 15128/35128) and attach
# verified NIP-05 handles to the pubkeys found. Set to "false" to run this
# process as an NCC-02/NCC-05-only indexer.
NCC_SEARCH_ENABLE_NSITE=true

# Also discover and index NIP-23 articles (kind 30023), NIP-68 pictures
# (kind 20) and NIP-71 videos (kind 21/22/34235/34236). Unlike NCC-02/nsite
# these need no fetch/verify step -- the indexable content is already
# inline in the event -- and image/video bytes are never fetched by this
# backend at all; the browser loads them directly (see ui/).
NCC_SEARCH_ENABLE_CONTENT=true

# Also discover and index Nostr profiles (kind:0 metadata), surfaced in
# ui/'s dedicated "Profiles" grid tab, with the same NIP-05 verification
# pass nsite/article/media get.
NCC_SEARCH_ENABLE_PROFILES=true

# Also discover and index npack (github.com/imattau/npack) package releases
# (kind:9900) and their kind:1063 NIP-94 artifact metadata (download
# URL/MIME type). This backend never fetches/verifies the .npk bytes
# themselves -- that's a package manager client's job, not a search index's.
NCC_SEARCH_ENABLE_NPACK=true

# At search time, also live-query whichever of NCC_SEARCH_RELAYS advertise
# NIP-50 ("search" filter field) support in their NIP-11 document. Matches
# are fed into the normal resolve/fetch/verify pipeline, not trusted as-is;
# a request can still skip this per-call with GET /search?live=false.
NCC_SEARCH_ENABLE_NIP50=true

# CORS origin(s) allowed to call this API from a browser (comma-separated).
# Unset/empty reflects any request origin, which is fine for this public,
# unauthenticated, read-only search API -- needed for ui/ (a separate
# origin/port) to call it at all. Set this once ui/ has a fixed deployed
# origin to restrict it.
NCC_SEARCH_CORS_ORIGIN=
