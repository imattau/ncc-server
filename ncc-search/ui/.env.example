# Base URL of the ncc-search backend's HTTP API (see ../README.md).
VITE_NCC_SEARCH_API_BASE=http://127.0.0.1:7780

# Relays this page's own Nostr pool uses for client-side extras (profile
# lookups for display names/avatars). Independent of the backend's
# NCC_SEARCH_RELAYS, but keeping them the same is the sane default.
VITE_NCC_SEARCH_RELAYS=wss://relay.primal.net,wss://relay.damus.io

# Memory ceiling, in bytes, for the resized-image cache (useResizedImage.ts)
# -- each cached entry is a live decoded image held via a blob: object URL
# for the rest of the page's life, so an unbounded cache could grow for as
# long as the tab stays open. Least-recently-used entries (that nothing on
# screen is currently displaying) are evicted first once this is exceeded.
# Empty uses the built-in default of 150MB.
VITE_NCC_SEARCH_IMAGE_CACHE_MAX_BYTES=
