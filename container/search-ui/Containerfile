FROM node:24-bookworm-slim AS build
WORKDIR /src
COPY ncc-search/ui/package.json ncc-search/ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ncc-search/ui/ ./
# The generated UI uses same-origin API requests; relay configuration is
# written at container startup so the image can be reused across deployments.
RUN npm run build

FROM nginx:1.29-alpine
COPY container/search-ui/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /src/dist/ /srv/ncc-search-ui/
COPY container/search-ui/40-ncc-search-runtime-config.sh /docker-entrypoint.d/40-ncc-search-runtime-config.sh
RUN chmod 0755 /docker-entrypoint.d/40-ncc-search-runtime-config.sh
EXPOSE 8080
USER 101:101
