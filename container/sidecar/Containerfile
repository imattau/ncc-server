ARG NODE_IMAGE=node:24.12.0-bookworm-slim

FROM ${NODE_IMAGE} AS build
ARG SIDECAR_REPO=https://github.com/imattau/nostr-community-conventions.git
ARG SIDECAR_REV=d67fa15b40a3461588c96da56710bec6fd670b5b
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git patch python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
RUN git clone --filter=blob:none --no-checkout "$SIDECAR_REPO" /src \
  && git -C /src fetch --depth 1 origin "$SIDECAR_REV" \
  && git -C /src checkout --detach FETCH_HEAD
COPY patches/ncc-sidecar-event-ack.patch /tmp/ncc-sidecar-event-ack.patch
COPY patches/ncc-sidecar-tor-auth-log.patch /tmp/ncc-sidecar-tor-auth-log.patch
COPY patches/ncc-sidecar-tor-control-close.patch /tmp/ncc-sidecar-tor-control-close.patch
COPY patches/ncc-sidecar-panel-admin-api.patch /tmp/ncc-sidecar-panel-admin-api.patch
COPY patches/ncc-sidecar-panel-services.patch /tmp/ncc-sidecar-panel-services.patch
COPY patches/ncc-sidecar-npack.patch /tmp/ncc-sidecar-npack.patch
COPY patches/ncc-sidecar-panel-metrics.patch /tmp/ncc-sidecar-panel-metrics.patch
COPY patches/ncc-sidecar-npanel-sync.patch /tmp/ncc-sidecar-npanel-sync.patch
WORKDIR /src/ncc-06/ncc-sidecar
RUN patch --dry-run -p1 < /tmp/ncc-sidecar-event-ack.patch \
  && patch -p1 < /tmp/ncc-sidecar-event-ack.patch \
  && patch --dry-run -p1 < /tmp/ncc-sidecar-tor-auth-log.patch \
  && patch -p1 < /tmp/ncc-sidecar-tor-auth-log.patch \
  && if ! grep -q 'Tor control connection closed before replying' src/tor-control.js; then \
       patch --dry-run -p1 < /tmp/ncc-sidecar-tor-control-close.patch \
       && patch -p1 < /tmp/ncc-sidecar-tor-control-close.patch; \
     fi \
  && if [ ! -f src/routes/panel-settings.js ]; then \
       patch --dry-run -p1 < /tmp/ncc-sidecar-panel-admin-api.patch \
       && patch -p1 < /tmp/ncc-sidecar-panel-admin-api.patch; \
     fi \
  && if [ ! -f src/routes/panel-services.js ]; then \
       patch --dry-run -p1 < /tmp/ncc-sidecar-panel-services.patch \
       && patch -p1 < /tmp/ncc-sidecar-panel-services.patch; \
     fi \
  && if [ ! -f src/routes/panel-catalogue.js ]; then \
       patch --dry-run -p1 < /tmp/ncc-sidecar-npack.patch \
       && patch -p1 < /tmp/ncc-sidecar-npack.patch; \
     fi \
  && if ! grep -q 'ncc-api/metrics' src/routes/panel-services.js; then \
       patch --dry-run -p1 < /tmp/ncc-sidecar-panel-metrics.patch \
       && patch -p1 < /tmp/ncc-sidecar-panel-metrics.patch; \
     fi \
  && if ! grep -q 'npanel-admins' src/routes/panel-admin.js; then \
       patch --dry-run -p1 < /tmp/ncc-sidecar-npanel-sync.patch \
       && patch -p1 < /tmp/ncc-sidecar-npanel-sync.patch; \
     fi \
  && npm ci \
  && npm --prefix ui ci \
  && npm --prefix ui run build \
  && npm prune --omit=dev

ARG SIDECAR_UID=996
ARG SIDECAR_GID=995
FROM ${NODE_IMAGE} AS runtime
ARG SIDECAR_UID=996
ARG SIDECAR_GID=995
ENV NODE_ENV=production \
    NCC_SIDECAR_DB_PATH=/data/sidecar.db \
    NCC_SIDECAR_ALLOW_REMOTE=false \
    ADMIN_HOST=127.0.0.1 \
    ADMIN_PORT=3000
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 zstd \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid "$SIDECAR_GID" ncc-sidecar \
  && useradd --uid "$SIDECAR_UID" --gid "$SIDECAR_GID" --home-dir /app --shell /usr/sbin/nologin ncc-sidecar \
  && mkdir -p /app/certs /data \
  && chown -R "$SIDECAR_UID:$SIDECAR_GID" /app /data
WORKDIR /app
COPY --from=build /src/ncc-06/ncc-sidecar/ /app/
# Narrow Docker control plane for `make bundle-up`'s node-agent container.
# It uses the same image with a different command and never runs in the
# sidecar process itself.
COPY container/sidecar/node-agent.mjs /app/node-agent.mjs
# ncc-06-js imports nostr-tools without declaring it in its own package manifest.
RUN npm install --prefix /app --no-save --omit=dev nostr-tools@2.19.4
USER ${SIDECAR_UID}:${SIDECAR_GID}
EXPOSE 3000
CMD ["node", "src/index.js"]
