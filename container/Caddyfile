{
	admin 127.0.0.1:2019
	auto_https disable_redirects
}

:{$CONTENT_PORT} {
	root * {$CONTENT_ROOT}
	encode gzip
	try_files {path} /index.html
	file_server
	log {
		output stdout
	}
}

:{$CONTENT_TLS_PORT} {
	tls {$WEB_CERT} {$WEB_KEY}
	@npanel {
		header X-NCC-Pubkey {$NCC_OPERATOR_PUBKEY}
		header X-NCC-Service npanel
	}
	@ditto {
		header X-NCC-Pubkey {$NCC_OPERATOR_PUBKEY}
		header X-NCC-Service ditto
	}
	handle @npanel {
		reverse_proxy 127.0.0.1:3200 {
			header_up Host {$PUBLIC_IPV4}
			header_up -X-NCC-Pubkey
			header_up -X-NCC-Service
		}
	}
	handle @ditto {
		reverse_proxy 127.0.0.1:3210 {
			header_up Host {$PUBLIC_IPV4}
			header_up -X-NCC-Pubkey
			header_up -X-NCC-Service
		}
	}
	handle_path /relay/* {
		reverse_proxy 127.0.0.1:13131 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle /nsite/* {
		reverse_proxy 127.0.0.1:3200 {
			header_up Host {$PUBLIC_IPV4}
		}
	}
	handle {
		root * {$CONTENT_ROOT}
		encode gzip
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
	}
}

:{$SEARCH_TLS_PORT} {
	tls {$WEB_CERT} {$WEB_KEY}
	reverse_proxy 127.0.0.1:3220 {
		header_up Host {$PUBLIC_IPV4}
	}
	log {
		output stdout
	}
}

:{$SEARCH_API_TLS_PORT} {
	tls {$WEB_CERT} {$WEB_KEY}
	reverse_proxy 127.0.0.1:3230 {
		header_up Host {$PUBLIC_IPV4}
	}
	log {
		output stdout
	}
}
