{
	admin 127.0.0.1:2019
	auto_https disable_redirects
	# Slowloris and slow-POST protection for a directly exposed node. The
	# header timeout bounds the handshake; the body timeout bounds the whole
	# body read; idle closes inactive keep-alive connections.
	servers {
		timeouts {
			read_header 10s
			read_body 5m
			idle 5m
		}
	}
}

# Every browser-facing service gets its own dedicated port rather than
# sharing one origin via a custom X-NCC-Pubkey/X-NCC-Service request
# header: that scheme broke in several different ways for services we
# don't control the source of (npanel, ditto-web) -- WebSocket handshakes
# can't carry custom headers at all, a page's own
# `fetch(window.location.origin)` self-detection breaks under ncc://, and
# ncc-browser's own subresource routing for root-relative asset paths is a
# best-effort Referer/active-tab heuristic (its own documented limitation)
# that can misroute one service's assets to another once more than one
# tab is open under the same npub. A dedicated port sidesteps all of that
# at once: there's only one possible destination, so none of those
# ambiguity-dependent failure modes exist on it.
#
# ncc-browser itself no longer attaches x-ncc-pubkey/x-ncc-service to its
# upstream requests either (removed in ncc-browser's own routing.ts, since
# nothing server-side has consumed them since the move above) -- their
# mere presence on an otherwise-simple GET/HEAD used to force a CORS
# preflight (OPTIONS) before every single subresource load, which only
# worked if the destination happened to answer OPTIONS correctly. Caddy's
# own file_server, ditto-web's nginx, and search-ui's nginx all didn't, by
# default -- found live on ditto's and search's own assets. With the
# headers gone, no preflight is triggered at all for a plain resource
# load, so there's nothing left to answer here.
(cors_response) {
	# ncc-browser's protocol handler still fetches the upstream resource
	# and returns it under the ncc:// origin, so Chromium still treats the
	# response as cross-origin and requires this on the actual GET/HEAD
	# response even without a preflight. Without it, the upstream can log
	# HTTP 200 while the browser's fetch rejects it and the NCC protocol
	# reports its generic 502 endpoint-unreachable page.
	header Access-Control-Allow-Origin "*"
}

# Baseline response headers for every browser-facing service. Referrer-Policy
# keeps the origin (which carries the per-service ncc:// host) but not paths;
# nosniff stops browsers from reinterpreting a proxied asset as a script or
# stylesheet when an upstream labels it wrongly.
(ncc_security_headers) {
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
	}
}

# Small limits are enough for the static pages, the admin API and the relay
# handshake. Large-upload services get the wider cap below.
(ncc_body_small) {
	request_body {
		max_size 5MB
	}
}

# npanel and Ditto can receive nsite or media uploads. Keep a bound without
# pretending every upload is tiny.
(ncc_body_app) {
	request_body {
		max_size 50MB
	}
}

# The welcome page and admin panel read the operator identity here. Compose
# already passes the hex pubkey to Caddy, so this stays correct even when a
# deploy removes the generated ncc-config.json file: the client encodes the
# hex key to an npub. Under ncc:// both pages also fall back to the npub in
# the address itself. `panelApi` is the absolute origin the admin panel signs
# its NIP-98 requests for, because an ncc:// page cannot see the https
# endpoint it was fetched from.
(ncc_public_config) {
	handle /ncc-config.json {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"pubkey":"{$NCC_OPERATOR_PUBKEY}","panelApi":"https://{$PUBLIC_IPV4}:{$ADMIN_PANEL_TLS_PORT}/ncc-api"}`
	}
}

# The admin panel's management API. The sidecar listens on host loopback only,
# so this is its single public ingress. Every request must carry a NIP-98
# Authorization header signed by an admin key; the sidecar verifies the
# signature, URL and method (patches/ncc-sidecar-panel-admin-api.patch). Caddy
# handles the preflight and removes Origin because @fastify/cors rejects the
# endpoint origin the NCC protocol handler rewrites ncc:// requests to.
(ncc_admin_api) {
	handle /ncc-api/* {
		@preflight method OPTIONS
		handle @preflight {
			header Access-Control-Allow-Origin "*"
			header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
			header Access-Control-Allow-Headers "Authorization, Content-Type"
			header Access-Control-Max-Age "600"
			respond "" 204
		}
		reverse_proxy 127.0.0.1:3000 {
			header_up -Origin
			# The sidecar rebuilds the signed URL from this scheme and the Host
			# header Caddy forwards unchanged (including the port).
			header_up X-Forwarded-Proto {scheme}
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Allow-Origin
		}
	}
}

# The admin service also has an onion endpoint. A page fetched through an
# onion must sign that onion origin, not the public HTTPS one, and Caddy can
# only learn it from the request Host. The onion page's relative /ncc-api
# requests stay on the onion, so the sidecar accepts the matching Host.
(ncc_onion_config) {
	handle /ncc-config.json {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"pubkey":"{$NCC_OPERATOR_PUBKEY}","panelApi":"http://{http.request.host}/ncc-api"}`
	}
}

:{$CONTENT_PORT} {
	import ncc_security_headers
	import ncc_body_small
	import cors_response
	import ncc_public_config
	handle {
		root * {$CONTENT_ROOT}
		encode gzip
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
	}
}

:{$CONTENT_TLS_PORT} {
	import ncc_security_headers
	import ncc_body_small
	tls {$WEB_CERT} {$WEB_KEY}
	import cors_response
	import ncc_public_config
	handle /nsite/* {
		reverse_proxy 127.0.0.1:3200 {
			header_up Host {$PUBLIC_IPV4}
		}
	}
	handle {
		root * {$CONTENT_ROOT}
		encode gzip
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
	}
}

:{$RELAY_TLS_PORT} {
	import ncc_security_headers
	import ncc_body_small
	tls {$RELAY_CERT} {$RELAY_KEY}
	# Its own cert (sidecar record id 3), not WEB_CERT -- the relay profile
	# has always been provisioned with a separate certificate from web/
	# npanel/ditto/search's shared one. Moving the relay under a shared
	# port+cert (as a /relay/* path on CONTENT_TLS_PORT) left its NCC-02
	# locator record pinned to this cert while Caddy was actually serving
	# WEB_CERT for that path -- a genuine pin mismatch, found live by
	# comparing the published "k" against the TLS handshake.
	reverse_proxy 127.0.0.1:13131 {
		header_up X-Real-IP {remote_host}
	}
	log {
		output stdout
	}
}

:{$DITTO_WEB_TLS_PORT} {
	import ncc_security_headers
	import ncc_body_app
	tls {$WEB_CERT} {$WEB_KEY}
	import cors_response
	# A dedicated port, not X-NCC-Pubkey/X-NCC-Service header routing, for
	# the same reason as npanel further down: ditto-web is a generic third-party
	# Nostr client whose own JS does normal same-origin things (relative
	# fetches, asset loads) with no idea a custom header convention
	# exists. Sharing one origin with another header-matched service also
	# means ncc-browser's own subresource routing (a best-effort
	# Referer/active-tab heuristic for root-relative asset paths, by its
	# own documented admission) can misroute one service's assets to
	# another when more than one tab is open under the same npub -- found
	# live as every one of ditto's JS/CSS assets coming back as the
	# wrong page (MIME-type errors), not just a CORS failure.
	reverse_proxy 127.0.0.1:3210 {
		header_up Host {$PUBLIC_IPV4}
	}
	log {
		output stdout
	}
}

:{$NPANEL_TLS_PORT} {
	import ncc_security_headers
	import ncc_body_app
	tls {$WEB_CERT} {$WEB_KEY}
	import cors_response
	# A dedicated port, bypassing the X-NCC-Pubkey/X-NCC-Service header
	# routing above, so npanel gets a real https:// origin with a
	# certificate the node already pins. Opening its ncc:// address also
	# works (the browser's ncc scheme is a secure, fetch-capable origin,
	# and npanel's NIP-98 check accepts the per-service host form that
	# origin uses), but the port stays the supported direct address, the
	# one the healthcheck and the docs use.
	reverse_proxy 127.0.0.1:3200 {
		header_up Host {$PUBLIC_IPV4}
	}
	log {
		output stdout
	}
}

:{$SEARCH_TLS_PORT} {
	import ncc_security_headers
	import ncc_body_small
	tls {$WEB_CERT} {$WEB_KEY}
	# The UI and its API share this one origin on purpose -- a browser's
	# own JS only gets the special NCC-02 "k"-pin trust an ncc:// client
	# extends to the host it actually resolved. A second hostname/port for
	# the API would be a genuinely different origin that was never itself
	# resolved via ncc://, so the page's own `fetch()` to it falls back to
	# ordinary CA trust and rejects this self-signed cert outright -- found
	# live as ERR_CERT_AUTHORITY_INVALID only on the API calls, never on
	# the page load itself. Keeping both under one port is what makes the
	# trust the client already established actually cover the API too.
	handle /search* {
		# No `import cors_response` here, deliberately: the backend's own
		# @fastify/cors already answers preflights and sets a correct,
		# origin-reflecting Access-Control-Allow-Origin on every response.
		# Caddy's own blanket "*" would land on top of that, producing TWO
		# ACAO values on one response -- which the Fetch spec treats as an
		# outright failure, not a redundant-but-harmless duplicate. Found
		# live: "contains multiple values '*, ncc://npub...'" in the
		# console, once this port started serving both UI and API.
		reverse_proxy 127.0.0.1:3230 {
			header_up Host {$PUBLIC_IPV4}
		}
	}
	handle /status* {
		reverse_proxy 127.0.0.1:3230 {
			header_up Host {$PUBLIC_IPV4}
		}
	}
	handle {
		import cors_response
		reverse_proxy 127.0.0.1:3220 {
			header_up Host {$PUBLIC_IPV4}
		}
	}
	log {
		output stdout
	}
}

# The admin panel is published as an NCC service on its own pinned port. The
# panel assets are baked into this Caddy image and served from /admin, so a
# Caddy image update also updates the panel even when CONTENT_ROOT holds an
# operator's own welcome page. The service root must be / because NCC Browser
# joins the endpoint path with the request path, and it cannot be an HTTP
# redirect: NCC Browser fetches endpoints with redirect: 'manual', which
# Electron reports as "Redirect was cancelled". Return a tiny 200 document
# that navigates to /admin instead.
:{$ADMIN_PANEL_TLS_PORT} {
	import ncc_security_headers
	import ncc_body_small
	tls {$WEB_CERT} {$WEB_KEY}
	import cors_response
	import ncc_public_config
	import ncc_admin_api
	root * /srv/ncc-server/admin-panel
	encode gzip
	handle_path /admin-static/* {
		file_server
	}
	handle / {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="refresh" content="0; url=/admin"><title>NCC Server Admin Panel</title></head><body><p><a href="/admin">Open the NCC Server Admin Panel</a></p></body></html>`
	}
	handle {
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
	}
}

# The admin panel is also bundled into the NCC Caddy image and served on host
# loopback, for operators who reach it through an SSH tunnel. Admin writes use
# the same NIP-98-authorized API as the public listener.
http://127.0.0.1:{$ADMIN_PANEL_PORT} {
	import ncc_security_headers
	import ncc_body_small
	bind 127.0.0.1
	import ncc_public_config
	import ncc_admin_api
	root * /srv/ncc-server/admin-panel
	encode gzip
	handle_path /admin-static/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
	}
}

# Loopback-only HTTP listeners for the Tor onion services. Tor's ADD_ONION
# maps onion port 80 to one local port per service, so each service can have a
# distinct onion address while keeping its normal public TLS endpoint and
# Host-based routing. Onion clients use http:// and ws:// because the onion
# address itself provides encryption; these ports are never published.
http://:{$TOR_NPANEL_PORT} {
	import ncc_security_headers
	import ncc_body_app
	bind 127.0.0.1
	import cors_response
	reverse_proxy 127.0.0.1:3200 {
		header_up Host {$PUBLIC_IPV4}
	}
	log {
		output stdout
	}
}

http://:{$TOR_DITTO_WEB_PORT} {
	import ncc_security_headers
	import ncc_body_app
	bind 127.0.0.1
	import cors_response
	reverse_proxy 127.0.0.1:3210 {
		header_up Host {$PUBLIC_IPV4}
	}
	log {
		output stdout
	}
}

http://:{$TOR_SEARCH_PORT} {
