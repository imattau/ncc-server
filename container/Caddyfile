{
	admin 127.0.0.1:2019
	auto_https disable_redirects
}

# ncc-browser's webview sends a CORS preflight (OPTIONS) for every
# subresource of a page it navigated to via ncc://, even same-origin ones
# -- found live on ditto-web's own assets, not just ncc-search's. Caddy's
# own file_server (serving web's content root and nsite paths), ditto-web's
# nginx, and search-ui's nginx all answer OPTIONS with a bare 405 and no
# CORS headers by default, so the browser aborts every asset fetch after
# the document itself, leaving the page blank. This answers the preflight
# before it ever reaches a backend, for every port that serves a
# browser-facing page.
#
# Also sets Vary on X-NCC-Pubkey/X-NCC-Service: npanel and ditto are routed
# by those request headers alone, both landing on the exact same URL
# (https://{$PUBLIC_IPV4}:{$CONTENT_TLS_PORT}/). Without declaring that the
# response depends on them, nothing stops the browser's own HTTP cache from
# reusing whatever it cached for one service's request on a later request
# for the other, since the URL never changed -- found live: switching from
# one ncc:// address to another kept showing the previous service's page
# until a hard reload bypassed the cache.
(cors_preflight) {
	# ncc-browser's protocol handler fetches the upstream resource and then
	# returns it under the ncc:// origin. The preflight alone is insufficient:
	# Chromium also requires ACAO on the actual GET/HEAD response. Without it,
	# the upstream can log HTTP 200 while the browser's fetch rejects and the
	# NCC protocol reports its generic 502 endpoint-unreachable page.
	header Access-Control-Allow-Origin "*"
	# `+Vary` appends rather than replacing -- npanel's own backend already
	# sets `Vary: Accept-Encoding` for gzip negotiation, and overwriting
	# that would be its own cache-correctness bug.
	header +Vary "X-NCC-Pubkey, X-NCC-Service"
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "*"
		respond 204
	}
}

:{$CONTENT_PORT} {
	import cors_preflight
	root * {$CONTENT_ROOT}
	encode gzip
	try_files {path} /index.html
	file_server
	log {
		output stdout
	}
}

:{$CONTENT_TLS_PORT} {
	tls {$WEB_CERT} {$WEB_KEY}
	import cors_preflight
	@npanel {
		header X-NCC-Pubkey {$NCC_OPERATOR_PUBKEY}
		header X-NCC-Service npanel
	}
	@ditto {
		header X-NCC-Pubkey {$NCC_OPERATOR_PUBKEY}
		header X-NCC-Service ditto
	}
	handle @npanel {
		reverse_proxy 127.0.0.1:3200 {
			header_up Host {$PUBLIC_IPV4}
			header_up -X-NCC-Pubkey
			header_up -X-NCC-Service
		}
	}
	handle @ditto {
		reverse_proxy 127.0.0.1:3210 {
			header_up Host {$PUBLIC_IPV4}
			header_up -X-NCC-Pubkey
			header_up -X-NCC-Service
		}
	}
	handle_path /relay/* {
		reverse_proxy 127.0.0.1:13131 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle /nsite/* {
		reverse_proxy 127.0.0.1:3200 {
			header_up Host {$PUBLIC_IPV4}
		}
	}
	handle {
		root * {$CONTENT_ROOT}
		encode gzip
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
	}
}

:{$SEARCH_TLS_PORT} {
	tls {$WEB_CERT} {$WEB_KEY}
	# The UI and its API share this one origin on purpose -- a browser's
	# own JS only gets the special NCC-02 "k"-pin trust an ncc:// client
	# extends to the host it actually resolved. A second hostname/port for
	# the API would be a genuinely different origin that was never itself
	# resolved via ncc://, so the page's own `fetch()` to it falls back to
	# ordinary CA trust and rejects this self-signed cert outright -- found
	# live as ERR_CERT_AUTHORITY_INVALID only on the API calls, never on
	# the page load itself. Keeping both under one port is what makes the
	# trust the client already established actually cover the API too.
	handle /search* {
		# No `import cors_preflight` here, deliberately: the backend's own
		# @fastify/cors already answers preflights and sets a correct,
		# origin-reflecting Access-Control-Allow-Origin on every response.
		# Caddy's own blanket "*" would land on top of that, producing TWO
		# ACAO values on one response -- which the Fetch spec treats as an
		# outright failure, not a redundant-but-harmless duplicate. Found
		# live: "contains multiple values '*, ncc://npub...'" in the
		# console, once this port started serving both UI and API.
		reverse_proxy 127.0.0.1:3230 {
			header_up Host {$PUBLIC_IPV4}
		}
	}
	handle {
		import cors_preflight
		reverse_proxy 127.0.0.1:3220 {
			header_up Host {$PUBLIC_IPV4}
		}
	}
	log {
		output stdout
	}
}
