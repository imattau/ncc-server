# Copy this file to .env. The installer prompts for the server's public IPv4.
PUBLIC_IPV4=
CONTENT_PORT=8080
CONTENT_TLS_PORT=8443
# Every browser-facing service gets its own dedicated TLS port rather than
# sharing one origin via a custom request header -- see container/
# Caddyfile's top-of-file comment for why that scheme broke in several
# different ways for services whose source we don't control (npanel,
# ditto-web): WebSocket handshakes can't carry custom headers, a page's
# own window.location-based self-detection breaks under ncc://, and
# ncc-browser's own subresource routing for root-relative asset paths is
# a best-effort heuristic that misroutes once more than one tab is open
# under the same npub.
RELAY_TLS_PORT=8444
DITTO_WEB_TLS_PORT=8446
NPANEL_TLS_PORT=8445
# UI and API share this one port/origin on purpose -- see container/
# Caddyfile's comment on the search block for why a separate API port
# would fail browser cert trust for ncc:// clients.
SEARCH_TLS_PORT=8447
# Local-only management panel; use an SSH tunnel until key auth is connected.
ADMIN_PANEL_PORT=8081
# Public pinned HTTPS port for the Admin Panel NCC service. The panel can
# manage installed services; see docs/admin-panel.md.
ADMIN_PANEL_TLS_PORT=8448
CONTENT_ROOT=/srv/ncc-server/public

# Loopback-only control API for the admin panel's container actions. The
# node-agent companion container holds the Docker socket; the sidecar calls it
# with this token. Leave the token empty to disable container controls.
NODE_AGENT_PORT=3010
NODE_AGENT_TOKEN=

# Server Upgrade button state. The node-agent writes a request file here; a
# systemd path unit runs the fixed upgrade runner. The release directory is
# mounted read-only and records the checkout's release tag for the panel's
# availability check. Keep the defaults unless the host moved them.
NCC_UPGRADE_STATE_DIR=/var/lib/ncc-server-upgrade
NCC_RELEASE_DIR=/var/lib/ncc-server-release

# Private NCC services. Comma-separated service IDs whose NCC-05 locator is
# NIP-44 encrypted instead of published in plaintext. NCC_PRIVATE_RECIPIENTS
# is a comma-separated npub list added to every private service. The operator
# key is always a recipient; node admins are added by the CLI and panel unless
# explicitly excluded. Private is unlisting, not access control. Leave empty
# for the standard public node; use `make service-private` after install to
# change visibility without editing this file.
NCC_PRIVATE_SERVICES=
NCC_PRIVATE_RECIPIENTS=

# App catalogue: a read-only npack daemon that discovers signed NCC service
# packages on Nostr and their .npk descriptors on Blossom. It never installs
# anything and has no Docker access. Set the official publisher npub to mark
# those packages as trusted; every other publisher needs explicit trust from
# the panel. See docs/npack-services.md.
NPACK_IMAGE=ghcr.io/imattau/ncc-server-npack:latest
NPACK_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
NPACK_BLOSSOM_SERVERS=https://blossom.primal.net,https://cdn.satellite.earth
NCC_NPACK_OFFICIAL_PUBLISHER=

# Loopback-only HTTP listeners for the per-service Tor onion services. Tor
# maps onion port 80 to the matching local port; none of these are published.
# The web onion uses CONTENT_PORT and the relay onion uses the relay backend.
TOR_NPANEL_PORT=18045
TOR_DITTO_WEB_PORT=18046
TOR_SEARCH_PORT=18047
TOR_ADMIN_PORT=18048

# Persistent state paths. Keep existing values when adopting a native install.
SIDECAR_DATA_DIR=/var/lib/ncc-sidecar
SIDECAR_CERT_DIR=/opt/ncc-sidecar/certs
NPANEL_DATA_DIR=/var/lib/npanel
SEARCH_DATA_DIR=/var/lib/ncc-search
TOR_DATA_DIR=/var/lib/tor
TOR_CONFIG_FILE=/etc/tor/torrc
DITTO_RELAY_REV=e8974053dcf99ac952d1951deaffec105aeb08f1
DITTO_ENV_FILE=/etc/ncc-server/ditto-relay.env
OPENSEARCH_VOLUME=ditto-relay_opensearch-data
CADDY_DATA_VOLUME=ncc-bundle_caddy-data
CADDY_CONFIG_VOLUME=ncc-bundle_caddy-config

# Container numeric IDs; preserve existing values when adopting existing data.
SIDECAR_UID=996
SIDECAR_GID=995
SIDECAR_CERT_GID=996
NPANEL_UID=994
NPANEL_GID=994
# These match the published Tor image and must stay fixed for Compose installs.
TOR_UID=102
TOR_GID=109
CADDY_GID=996
SEARCH_UID=997
SEARCH_GID=997

SIDECAR_REPO=https://github.com/imattau/nostr-community-conventions.git
SIDECAR_REV=17b0439cc1335ad22a082d3e90d1863dc10208b8

# Web app build source: NCC changes in this fork are pinned by immutable commit.
DITTO_WEB_REPO=https://gitlab.com/imattau/ditto.git
DITTO_WEB_REV=bfbeef619021d965583301a035749324c3c7c413

# Public component images. Override each tag independently to pin or upgrade
# one service without changing the others. The admin panel's Apps page pulls
# the tag shown here and recreates the container when the digest changed, so a
# pin stays where it is until you change this file; `latest` follows releases.
TOR_IMAGE=ghcr.io/imattau/ncc-server-tor:latest
SIDECAR_IMAGE=ghcr.io/imattau/ncc-server-sidecar:latest
RELAY_IMAGE=ghcr.io/imattau/ncc-server-relay:latest
NPANEL_IMAGE=ghcr.io/imattau/ncc-server-npanel:latest
DITTO_WEB_IMAGE=ghcr.io/imattau/ncc-server-ditto-web:latest
SEARCH_IMAGE=ghcr.io/imattau/ncc-server-search:latest
SEARCH_UI_IMAGE=ghcr.io/imattau/ncc-server-search-ui:latest
# Optional image that adds the local-only admin panel assets to Caddy.
# CADDY_IMAGE=ghcr.io/imattau/ncc-server-caddy:latest

# How often the sidecar re-checks that every node admin is an npanel admin,
# in minutes, and adds any npanel never learned about (admins that predate
# the mirror, or that were added while npanel was down). 0 disables the pass.
# Set it on the sidecar as NCC_NPANEL_RECONCILE_MINUTES; staff roles are left
# for the panel's Grant action.
NPANEL_RECONCILE_MINUTES=5

# ncc-search (see ncc-search/README.md): a separate, read-only, unauthenticated
# indexer/search API + its own UI, bundled as two more containers. It never
# signs or publishes a Nostr event -- it does NOT use the operator identity
# generated by the first-start bootstrap, and nothing here configures one for
# it. Relays to crawl (shared default: the same public relays the bundle
# already publishes to). Empty CORS origin reflects any request origin, fine
# for this public, read-only API -- see ncc-search/ui/README.md. Empty max
# bytes leaves the index unbounded; see ncc-search/README.md's "Storage"
# section to opt into a disk-space ceiling.
SEARCH_RELAYS=wss://relay.primal.net,wss://relay.damus.io
SEARCH_LEARN_RELAYS=true
SEARCH_CORS_ORIGIN=
SEARCH_DB_MAX_BYTES=
# Zapstore's catalog relay is added for the app-listing subscription only
# (kind:32267), because app listings are rarely carried by general relays.
# Set to your own catalog relay, or leave it; disable the adapter entirely
# with NCC_SEARCH_ENABLE_APPS=false in a compose override.
SEARCH_APP_RELAYS=wss://relay.zapstore.dev
# Let the UI's "use my NIP-65 relay list" send a signed-in reader's public
# relays with /search, for the live NIP-50 fan-out only. Bounded by
# SEARCH_MAX_CLIENT_RELAYS and never written to the index; set to false to
# keep the API talking only to SEARCH_RELAYS.
SEARCH_ALLOW_CLIENT_RELAYS=true
SEARCH_MAX_CLIENT_RELAYS=3
