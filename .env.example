# Copy this file to .env. The installer prompts for the server's public IPv4.
PUBLIC_IPV4=
# Filled in by first-run-identity. Caddy uses this with X-NCC-Service to route.
NCC_OPERATOR_PUBKEY=
CONTENT_PORT=8080
CONTENT_TLS_PORT=8443
SEARCH_TLS_PORT=8447
SEARCH_API_TLS_PORT=8448
CONTENT_ROOT=/srv/ncc-server/public

# Persistent state paths. Keep existing values when adopting a native install.
SIDECAR_DATA_DIR=/var/lib/ncc-sidecar
SIDECAR_CERT_DIR=/opt/ncc-sidecar/certs
NPANEL_DATA_DIR=/var/lib/npanel
SEARCH_DATA_DIR=/var/lib/ncc-search
TOR_DATA_DIR=/var/lib/tor
TOR_CONFIG_FILE=/etc/tor/torrc
DITTO_SOURCE_DIR=/opt/ditto-relay/source
DITTO_RELAY_REV=e8974053dcf99ac952d1951deaffec105aeb08f1
DITTO_ENV_FILE=/etc/ncc-server/ditto-relay.env
OPENSEARCH_VOLUME=ditto-relay_opensearch-data
CADDY_DATA_VOLUME=ncc-bundle_caddy-data
CADDY_CONFIG_VOLUME=ncc-bundle_caddy-config

# Container numeric IDs; preserve existing values when adopting existing data.
SIDECAR_UID=996
SIDECAR_GID=995
SIDECAR_CERT_GID=996
NPANEL_UID=994
NPANEL_GID=994
TOR_UID=102
TOR_GID=109
CADDY_GID=996
SEARCH_UID=997
SEARCH_GID=997

SIDECAR_REPO=https://github.com/imattau/nostr-community-conventions.git
SIDECAR_REV=186c3ad50966a2319c354ace12e0a5a2267b75d9

# Web app build source: NCC changes in this fork are pinned by immutable commit.
DITTO_WEB_REPO=https://gitlab.com/imattau/ditto.git
DITTO_WEB_REV=29709b8b53d68109dfc14af7f3a44563d177e880

# ncc-search (see ncc-search/README.md): a separate, read-only, unauthenticated
# indexer/search API + its own UI, bundled as two more containers. It never
# signs or publishes a Nostr event -- it does NOT use the operator identity
# from docs/deployment-compose.md step 2, and nothing here configures one for
# it. Relays to crawl (shared default: the same public relays the bundle
# already publishes to). Empty CORS origin reflects any request origin, fine
# for this public, read-only API -- see ncc-search/ui/README.md. Empty max
# bytes leaves the index unbounded; see ncc-search/README.md's "Storage"
# section to opt into a disk-space ceiling.
SEARCH_RELAYS=wss://relay.primal.net,wss://relay.damus.io
SEARCH_CORS_ORIGIN=
SEARCH_DB_MAX_BYTES=
