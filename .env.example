# Copy this file to .env and adjust only the host paths and address for the VM.
# Unique test host so the Npanel locator does not hijack the web/onion host.
# Replace this nip.io address with a dashboard domain for a public deployment.
DASHBOARD_HOST=1.43.63.94.nip.io
DITTO_WEB_HOST=ditto.1.43.63.94.nip.io
CONTENT_PORT=8080
CONTENT_TLS_PORT=8443
RELAY_TLS_PORT=8444
CONTENT_ROOT=/srv/ncc-server/public

# Persistent state already used by the native VM installation.
SIDECAR_DATA_DIR=/var/lib/ncc-sidecar
SIDECAR_CERT_DIR=/opt/ncc-sidecar/certs
NPANEL_DATA_DIR=/var/lib/npanel
TOR_DATA_DIR=/var/lib/tor
TOR_CONFIG_FILE=/etc/tor/torrc
DITTO_SOURCE_DIR=/opt/ditto-relay/source
DITTO_ENV_FILE=/etc/ncc-server/ditto-relay.env
OPENSEARCH_VOLUME=ditto-relay_opensearch-data

# Preserve the service account ownership of the existing VM data.
SIDECAR_UID=996
SIDECAR_GID=995
SIDECAR_CERT_GID=996
NPANEL_UID=994
NPANEL_GID=994
TOR_UID=102
TOR_GID=109
CADDY_GID=996

SIDECAR_REPO=https://github.com/imattau/nostr-community-conventions.git
SIDECAR_REV=186c3ad50966a2319c354ace12e0a5a2267b75d9

# Web app build source: NCC changes in this fork are pinned by immutable commit.
DITTO_WEB_REPO=https://gitlab.com/imattau/ditto.git
DITTO_WEB_REV=29709b8b53d68109dfc14af7f3a44563d177e880
