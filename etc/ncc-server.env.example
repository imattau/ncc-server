# Caddy content service settings. The sidecar stores its own configuration and
# signing keys in its database; it does not consume this file.
CONTENT_PORT=8080
CONTENT_ROOT=/srv/ncc-server/public

# Optional pinned HTTPS listener. Enable with:
#   sudo make enable-tls SERVICE_RECORD_ID=<numeric-sidecar-service-id>
# The sidecar generates this certificate beneath /opt/ncc-sidecar/certs/<id>/.
# The HTTPS listener is not configured in this env file by default.

